llations":null}},"constellation":{"0":{"id":0,"talentId":1131,"name":"藤典藥劑的備製","description":"{LINK#N11130001}<color=#FFD780FF>「援護射擊」</color>{/LINK}命中敵人時，將為伊法恢復6點元素能量。每8秒至多依此方式恢復一次元素能量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ifa_01","effects":["N11130001"]},"1":{"id":1,"talentId":1132,"name":"祈禱彈道的助靈","description":"伊法處於夜魂加持狀態下時，基於隊伍中所有角色目前夜魂值的總和超過60點的部分，每1點夜魂值都將使伊法額外獲得4點{LINK#N11130002}<color=#FFD780FF>「救援要義」</color>{/LINK}。\\n此外，伊法持有「救援要義」的上限提升50點。\\n需要解鎖突破天賦{LINK#P1132101}<color=#FFD780FF>場中醫者視野</color>{/LINK}。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ifa_02","effects":["N11130002"]},"2":{"id":2,"talentId":1133,"name":"與夜談判的駁詞","description":"元素戰技<color=#FFD780FF>{LINK#S11132}空天疾護{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Ifa_01"},"3":{"id":3,"talentId":1134,"name":"糜爛應體的置換","description":"元素爆發<color=#FFD780FF>{LINK#S11135}複合鎮靜域{/LINK}</color>產生的固縛風場的持續時間延長至3秒。\\n此外，施放元素爆發<color=#FFD780FF>複合鎮靜域</color>後，伊法的元素精通提升100點，持續15秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ifa_03"},"4":{"id":4,"talentId":1135,"name":"萬物同生的共誓","description":"元素爆發<color=#FFD780FF>{LINK#S11135}複合鎮靜域{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Ifa_02"},"5":{"id":5,"talentId":1136,"name":"羽結所庇的諾言","description":"伊法長按進行{LINK#N11130001}<color=#FFD780FF>「援護射擊」</color>{/LINK}時，有50%機率發射一枚額外的秘藥彈，造成相當於伊法攻擊力120%的風元素傷害。該傷害視為普通攻擊傷害。\\n此外，不處於戰鬥狀態下時，伊法的夜魂加持狀態消耗的夜魂值與燃素降低20%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ifa_04","effects":["N11130001"]}},"dictionary":{"talent":["N11130003","N11130001","N11130004","N11130002"],"constellation":["N11130001","N11130002"],"effectsInfo":{"N11130003":{"id":11130003,"name":"夜魂加持·伊法","description":"持續消耗夜魂值。夜魂值耗盡時，或是再次施放時，伊法的夜魂加持將會結束。夜魂加持狀態具有如下特性：\\n·在咔庫庫的幫助下懸浮，提升伊法的移動速度與抗打斷能力，在這種狀態下，伊法將持續消耗夜魂值，維持懸浮狀態，進行衝刺或抬升高度時，將額外消耗夜魂值。\\n·普通攻擊時，依據點按、長按，將轉為以不同的方式進行「援護射擊」。","params":null,"props":["","","","",""]},"N11130001":{"id":11130001,"name":"援護射擊","description":"在夜魂加持狀態下，伊法的普通攻擊將會轉為進行援護射擊。\\n<color=#FFD780FF>點按</color>\\n發射秘藥彈。\\n<color=#FFD780FF>長按</color>\\n持續發射秘藥彈。\\n<color=#FFD780FF>秘藥彈</color>\\n造成具有夜魂性質的<color=#80FFD7FF>風元素傷害</color>，並在命中敵人時為隊伍中附近的所有角色恢復生命值，回復量受益於伊法自己的元素精通。","params":null,"props":["","","","",""]},"N11130004":{"id":11130004,"name":"鎮靜標記","description":"該效果會在片刻後爆發消失，並造成對應元素屬性的範圍傷害。至多對4名命中的敵人施加「鎮靜標記」。敵人無法同時處於多種元素屬性的「鎮靜標記」狀態下。","params":null,"props":["","","","",""]},"N11130002":{"id":11130002,"name":"救援要義","description":"上限為150點。基於伊法持有的救援要義，每1點救援要義會使隊伍中附近的角色觸發的擴散反應與感電反應造成的傷害提升1.5%，月感電反應造成的傷害提升0.2%，星擴散反應造成的傷害提升{PARAM#P1132101|5S100}%。救援要義將在伊法的夜魂加持結束時被移除。","params":[{"skillFull":"P1132101|5S100","skillId":1132101,"skillParam":{"paramNum":4,"paramValue":0.0024,"paramMultiplier":100}}],"props":["150","0.015","","",""]}}}}}