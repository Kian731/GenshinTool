"UI_Talent_S_Beidou_06","linkedConstellations":null},"6":{"skillId":2423,"type":2,"name":"擁濤踏潮","description":"隊伍中自己的角色游泳消耗的體力降低20%。\\n無法與效果完全相同的固有天賦疊加。","descriptionBuff":"","icon":"UI_Talent_Explosion_Swim","linkedConstellations":null},"9":{"skillId":2424,"type":2,"name":"引路明星","description":"長按施放元素戰技<color=#FFD780FF>捉浪</color>時，即便不受到攻擊，每0.8秒也會主動累積一層力量，提高釋放時造成的傷害。\\n此外，長按施放<color=#FFD780FF>捉浪</color>命中敵人時，還會依據累積的力量，獲得額外的增益效果：每累積一層力量，都會使其元素戰技的冷卻時間減少4秒，並為自身恢復8點元素能量，該效果每15秒至多觸發一次。\\n此外，處於{LINK#N11330003}<color=#FFD780FF>極星輝域</color>{/LINK}中時，北斗將會進入<color=#FFD780FF>輝映·星超導</color>狀態。","descriptionBuff":"","icon":"UI_Talent_S_Beidou_08","effects":["N11330003"],"linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":241,"name":"魚龍沉四方","description":"施放<color=#FFD780FF>斫雷</color>時：\\n產生一個傷害吸收量等於生命值上限16%的護盾，持續15秒。\\n該護盾對<color=#FFACFFFF>雷元素傷害</color>有250%的吸收效果。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Beidou_02"},"1":{"id":1,"talentId":242,"name":"赫赫雷湧起","description":"<color=#FFD780FF>斫雷</color>的閃雷能額外彈跳2個敵人。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Beidou_01"},"2":{"id":2,"talentId":243,"name":"潮奔驀引電","description":"<color=#FFD780FF>捉浪</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Beidou_01"},"3":{"id":3,"talentId":244,"name":"牽星覓鄉岸","description":"受到攻擊後的10秒內，北斗的普通攻擊附帶20%額外<color=#FFACFFFF>雷元素傷害</color>。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Beidou_03","advancedProps":[{"name":"Extra Electro DMG","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Elemental Burst"},"type":{"span":null,"text":"2.5s/3 Hits"}},"interruptionResistance":"30","interruptionResistanceStagger":{"staggerLevel":"Mute","horizontalForce":"0","verticalForce":"0"},"bluntAttack":false}]},"4":{"id":4,"talentId":245,"name":"踏浪霞連階","description":"<color=#FFD780FF>斫雷</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Beidou_02"},"5":{"id":5,"talentId":246,"name":"北斗祓幽孽","description":"<color=#FFD780FF>斫雷</color>持續期間，周圍敵人的<color=#FFACFFFF>雷元素抗性</color>降低15%。","descriptionBuff":"<color=#FFD780FF>斫雷</color>持續期間，周圍敵人的<color=#FFACFFFF>雷元素抗性</color>降低15%。\\n\\n<color=#FFD780FF>輝映·星超導</color>：斫雷持續期間，附近敵人的<color=#99FFFFFF>冰元素抗性</color>還會降低15%，且目前場上角色元素精通提升200點。","extraData":null,"icon":"UI_Talent_S_Beidou_04"}},"dictionary":{"talent":["N11330003"],"constellation":[],"effectsInfo":{"N11330003":{"id":11330003,"name":"極星輝域","description":"觸發星超導反應時，附近的區域會短暫變化為<color=#FFD780FF>極星輝域</color>。處於極星輝域中時，特定角色將會進入<color=#FFD780FF>輝映·星超導</color>狀態，使其不同技能分別獲得對應的強化效果。","params":null,"props":["","","","",""]}}},"buff":true}}