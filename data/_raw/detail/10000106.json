e":"800","verticalForce":"0"},"bluntAttack":true},{"name":"Normal Attack 3-Hit C","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"44.43","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"Normal Attack 4-Hit","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"155.4","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"400","verticalForce":"800"},"bluntAttack":true},{"name":"Charged Attack","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"120","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"655","verticalForce":"800"},"bluntAttack":true},{"name":"Plunging Attack Collision","elementalGaugeTheory":"0U","internalCooldown":null,"interruptionResistance":"35","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Low Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"150","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"High Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"200","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"0","verticalForce":"800"},"bluntAttack":true}]},"1":{"skillId":11062,"type":0,"name":"稱名之刻","description":"#依憑「爭鬥」的權柄，召喚人神傳承的「諸火武裝」，造成具有夜魂性質的<color=#FF9999FF>火元素傷害</color>。\\n施放後，瑪薇卡將恢復夜魂值至上限，並進入夜魂加持狀態。\\n\\n<color=#FFD780FF>諸火武裝</color>\\n依據點按、長按，以不同的形態解放諸火武裝。\\n\\n<color=#FFD780FF>點按</color>\\n「神名解放」：諸火武裝將以焚曜之環的形態顯現。焚曜之環將跟隨目前場上角色，並間歇性攻擊周圍的敵人，造成具有夜魂性質的<color=#FF9999FF>火元素傷害</color>。\\n\\n<color=#FFD780FF>長按</color>\\n「古名解放」：諸火武裝將以馳輪車的形態顯現。在這種狀態下，瑪薇卡能駕駛馳輪車高速移動，或是打開馳輪車的備用隱藏推進模組，短暫通過各種地形，以及在空中短暫滑翔。同時，瑪薇卡的普通攻擊、重擊與下落攻擊將轉為無法被附魔覆蓋的具有夜魂性質的<color=#FF9999FF>火元素傷害</color>；進行衝刺時，也會對路徑上的敵人造成具有夜魂性質的<color=#FF9999FF>火元素傷害</color>。\\n\\n處於夜魂加持狀態下時，點按元素戰技可以切換諸火武裝的形態；諸火武裝將在瑪薇卡的夜魂加持結束時消失。\\n\\n<color=#FFD780FF>夜魂加持·瑪薇卡</color>\\n依據諸火武裝的形態，持續消耗夜魂值。夜魂值耗盡時，瑪薇卡的夜魂加持將會結束。\\n\\n<i>如果{F#妳}{M#你}告訴瑪薇卡像馳輪車這樣的東西，在其他世界是需要有牌照來標示的，她也會很開心：\\n「我這可是唯一一臺，黃金號碼不是就隨我選了嗎？」</i>","descriptionBuff":null,"icon":"Skill_S_Mavuika_01","promote":{"1":{"level":1,"costItems":null,"coinCost":null,"description":["技能傷害|{param1:F1P}","焚曜之環傷害|{param2:F1P}","焚曜之環攻擊間隔|{param3:F1}秒","馳輪車普通攻擊一段傷害|{param4:F1P}","馳輪車普通攻擊二段傷害|{param5:F1P}","馳輪車普通攻擊三段傷害|{param6:F1P}","馳輪車普通攻擊四段傷害|{param7:F1P}","馳輪車普通攻擊五段傷害|{param8:F1P}","馳輪車衝刺傷害|{param9:F1P}","馳輪車重擊循環傷害|{param10:F1P}","馳輪車重擊終結傷害|{param11:F1P}","馳輪車墜地衝擊傷害|{param12:F1P}","夜魂值上限|{param13:I}點","冷卻時間|{param14:F1}秒","","","","","",""],"params":[0.744,1.28,2,0.572648,0.591327,0.699868,0.697047,0.910035,0.8084,0.989,1.376,1.5996,80,15,0,0,0,0,0,0]},"2":{"level":2,"costItems":{"104347":3,"112104":6},"coinCost":12500,"description":["技能傷害|{param1:F1P}","焚曜之環傷害|{param2:F1P}","焚曜之環攻擊間隔|{param3:F1}秒","馳輪車普通攻擊一段傷害|{param4:F1P}","馳輪車普通攻擊二段傷害|{param5:F1P}","馳輪車普通攻擊三段傷害|{param6:F1P}","馳輪車普通攻擊四段傷害|{param7:F1P}","馳輪車普通攻擊五段傷害|{param8:F1P}","馳輪車衝刺傷害|{param9:F1P}","馳輪車重擊循環傷害|{param10:F1P}","馳輪車重擊終結傷害|{param11:F1P}","馳輪車墜地衝擊傷害|{param12:F1P}","夜魂值上限|{param13:I}點","冷卻時間|{param14:F1}秒","","","","","",""],"params":[0.7998,1.376,2,0.619259,0.639459,0.756834,0.753784,0.984107,0.8742,1.0695,1.488,1.7298,80,15,0,0,0,0,0,0]},"3":{"level":3,"costItems":{"104348":2,"112105":3},"coinCost":17500,"description":["技能傷害|{param1:F1P}","焚曜之環傷害|{param2:F1P}","焚曜之環攻擊間隔|{param3:F1}秒","馳輪車普通攻擊一段傷害|{param4:F1P}","馳輪車普通攻擊二段傷害|{param5:F1P}","馳輪車普通攻擊三段傷害|{param6:F1P}","馳輪車普通攻擊四段傷害|{param7:F1P}","馳輪車普通攻擊五段傷害|{param8:F1P}","馳輪車衝刺傷害|{param9:F1P}","馳輪車重擊循環傷害|{param10:F1P}","馳輪車重擊終結傷害|{param11:F1P}","馳輪車墜地衝擊傷害|{param12:F1P}","夜魂值上限|{param13:I}點","冷卻時間|{param14:F1}秒","","","","","",""],"params":[0.8556,1.472,2,0.66587,0.68759,0.8138,0.81052,1.05818,0.94,1.15,1.6,1.86,80,15,0,0,0,0,0,0]},"4":{"level":4,"costItem