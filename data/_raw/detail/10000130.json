p":[{"id":4,"type":"normal"}]}},"4":{"skillId":13021,"type":2,"name":"野外觀察手記","description":"露米在場上時，露米附近敵人的<color=#FFE699FF>岩元素抗性</color>會降低15%。\\n\\n<color=#FFD780FF>月兆·滿輝</color>：莉奈婭的元素戰技<color=#FFD780FF>{LINK#S11302}對策·露米呀吼吼！{/LINK}</color>和元素爆發<color=#FFD780FF>{LINK#S11305}備忘·絕境生存指南{/LINK}</color>獲得強化，呼喚露米上場後，露米附近敵人的<color=#FFE699FF>岩元素抗性</color>還會進一步降低15%。","descriptionBuff":"","icon":"UI_Talent_S_Linnea_05","linkedConstellations":null},"5":{"skillId":13022,"type":2,"name":"萬類博物圖鑑","description":"依據隊伍中自己的目前場上角色，莉奈婭會提升隊伍中特定角色的元素精通，提升值基於莉奈婭防禦力的5%。若隊伍中自己的目前場上角色：\\n·為月兆角色：提升該角色的元素精通。\\n·不為月兆角色：提升莉奈婭自己的元素精通。","descriptionBuff":"","icon":"UI_Talent_S_Linnea_06","linkedConstellations":null},"6":{"skillId":13023,"type":2,"name":"月兆祝賜·棲地考察","description":"隊伍中的角色觸發水元素結晶反應時，將轉為觸發月結晶反應，且基於莉奈婭的防禦力，提升隊伍中角色造成的月結晶反應的基礎傷害：每100點防禦力都將提升0.7%月結晶反應的基礎傷害，至多依此方式提升14%傷害。\\n\\n此外，莉奈婭在隊伍中時，隊伍的<color=#FFD780FF>月兆</color>將會上升一級。","descriptionBuff":"","icon":"UI_Talent_S_Linnea_07","linkedConstellations":null},"8":{"skillId":13025,"type":2,"name":"大師級的冒險者","description":"不處於戰鬥狀態下時，莉奈婭進行<color=#FFD780FF>瞄準射擊</color>所需的蓄力時間大幅減少，並會轉為射出特製的<color=#FFD780FF>超便利快捷矢</color>，依據命中的目標，產生不同的效果。若命中的目標為：\\n·特定動物：<color=#FFD780FF>超便利快捷矢</color>會轉化為特殊的「網」，可以拘出小動物的神形，並以其為媒介，再次化出小動物的形體。每週可使用的「網」數量有限。\\n·鍛造用礦石的礦脈：莉奈婭會派出露米，快速破壞被<color=#FFD780FF>超便利快捷矢</color>標記的礦體，並收集掉落的礦石。若露米不在場上，則會短暫呼喚出露米，幫助莉奈婭獲得礦石。\\n\\n<color=#FFD780FF>超便利快捷矢</color>對敵人造成的傷害降低為原本的20%。此外，短時間內發射一定數量的<color=#FFD780FF>超便利快捷矢</color>後，莉奈婭需要進行短暫的休息，才能繼續發射。","descriptionBuff":"","icon":"UI_Talent_S_Linnea_08","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":1301,"name":"未完成的分類","description":"施放元素戰技<color=#FFD780FF>{LINK#S11302}對策·露米呀吼吼！{/LINK}</color>時，或觸發月籠諧奏時，莉奈婭將獲得6層<color=#FFD780FF>「歷覽編錄」</color>效果，該效果持續10秒，至多疊加18層。隊伍中附近的角色造成月結晶反應傷害時，將消耗一層「歷覽編錄」，提升造成的傷害，提升值相當於莉奈婭防禦力的75%。\\n此外，露米在<color=#FFD780FF>{LINK#N11300001}究極厲害形態{/LINK}</color>下使用<color=#FFD780FF>百萬噸重錘</color>時，莉奈婭可以消耗至多5層「歷覽編錄」，每層都會使造成的傷害提升，提升值相當於莉奈婭防禦力的150%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Linnea_01","effects":["N11300001"]},"1":{"id":1,"talentId":1302,"name":"喜或悲的諭告","description":"觸發月籠諧奏後的8秒內，隊伍中所有元素類型為<color=#80C0FFFF>水元素</color>與<color=#FFE699FF>岩元素</color>的角色的暴擊傷害提升40%，且露米在<color=#FFD780FF>{LINK#N11300001}究極厲害形態{/LINK}</color>下使用<color=#FFD780FF>百萬噸重錘</color>的暴擊傷害額外提升150%。\\n\\n<color=#FFD780FF>月兆·滿輝</color>：露米在<color=#FFD780FF>{LINK#N11300001}超厲害形態{/LINK}</color>下使用<color=#FFD780FF>加力重錘</color>時，或在究極厲害形態下使用<color=#FFD780FF>百萬噸重錘</color>時，會觸發一次月籠諧奏，且本次月籠諧奏視為隊伍中所有元素類型為<color=#80C0FFFF>水元素</color>與<color=#FFE699FF>岩元素</color>的角色均在反應中施加了元素。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Linnea_02","effects":["N11300001","N11300001"]},"2":{"id":2,"talentId":1303,"name":"熱鬧的紀錄頁","description":"元素戰技<color=#FFD780FF>{LINK#S11302}對策·露米呀吼吼！{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Linnea_01"},"3":{"id":3,"talentId":1304,"name":"專家的直感覺","description":"觸發月籠諧奏後的5秒內，莉奈婭與隊伍中自己的目前場上角色的防禦力分別提升25%。莉奈婭在場上時，上述防禦力提升效果可疊加。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Linnea_03"},"4":{"id":4,"talentId":1305,"name":"仙鄉的贈別禮","description":"元素爆發<color=#FFD780FF>{LINK#S11305}備忘·絕境生存指南{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Linnea_02"},"5":{"id":5,"talentId":1306,"name":"黃金獵犬之夢","description":"命之座<color=#FFD780FF>「未完成的分類」</color>的效果獲得強化：施放元素戰技<color=#FFD780FF>{LINK#S11302}對策·露米呀吼吼！{/LINK}</color>時，或觸發月籠諧奏時，莉奈婭將直接獲得最大層數的<color=#FFD780FF>「歷覽編錄」</color>效果。消耗<color=#FFD780FF>「歷覽編錄」</color>時，將消耗原本2倍的層數，並使傷害提升效果提高至原本的150%。\\n\\n<color=#FFD780FF>月兆·滿輝</color>：隊伍中附近的角色造成的月結晶反應傷害{LINK#N11190007}<color=#FFD780FF>擢升</color>{/LINK}25%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Linnea_04","effects":["N11190007"]}},"dictionary":{"talent":["N11300001"],"constellation":["N11300001","N11190007"],"effectsInfo":{"N11300001":{"id":11300001,"name":"露米·出擊形態","description":"露米有三種不同的出擊形態。\\n\\n<color=#FFD780FF>超厲害形態</color>\\n露米會使用<color=#FFD780FF>捶捶亂打</color>不斷攻擊附近的敵人，每次攻擊會造成2次<color=#FFE699FF>岩元素範圍傷害</color>。\\n若附近存在月籠，露米則會交替使用<color=#FFD780FF>捶捶亂打</color>與<color=#FFD780FF>加力重錘</color>，不斷攻擊附近的敵人。<color=#FFD780FF>加力重錘</color>會造成視為月結晶反應傷害的<color=#FFE699FF>岩元素範圍傷害</color>。\\n\\n<color=#FFD780FF>究極厲害形態</color>\\n露米會使用究極厲害的<color=#FFD780FF>百萬噸重錘</color>，對附近的敵人造成一次格外強力的、視為月結晶反應傷害的<color=#FFE699FF>岩元素範圍傷害</color>，並切換至<color=#FFD780FF>普通厲害形態</color>。\\n\\n<color=#FFD780FF>普通厲害形態</color>\\n雖然沒有其他形態那麼厲害，但也很厲害。\\n露米會以更長的間隔使用<color=#FFD780FF>捶捶亂打</color>，不斷攻擊附近的敵人，每次攻擊會造成2次<color=#FFE699FF>岩元素範圍傷害</color>。","params":null,"props":["","","","",""]},"N11190007":{"id":11190007,"name":"擢升","description":"特殊的傷害提升效果，與其他的傷害提升效果分別獨立計算。","params":null,"props":["","","","",""]}}}}}