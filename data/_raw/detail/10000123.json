horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Transmutation: Denial of Darkness 3-Hit","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"30","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"3":{"skillId":11235,"type":1,"name":"白化法·如光流變","description":"以不同的方式解放「獸」的力量。依據杜林的{LINK#N11230001}<color=#FFD780FF>精質轉變</color>{/LINK}狀態，杜林可以施放不同的元素爆發。\\n\\n<color=#FFD780FF>白化法·如光流變</color>\\n若杜林處於<color=#FFD780FF>白化之是</color>狀態，將施放元素爆發<color=#FFD780FF>白化法·如光流變</color>，對前方的敵人造成三次<color=#FF9999FF>火元素範圍傷害</color>，並將自身的力量以<color=#FFD780FF>「白焰之龍」</color>的形態顯現。「白焰之龍」將跟隨目前場上角色，並間歇性攻擊周圍的敵人，造成<color=#FF9999FF>火元素範圍傷害</color>，該傷害視為元素爆發傷害。\\n\\n<color=#FFD780FF>黑度法·如星陰燃</color>\\n若杜林處於<color=#FFD780FF>黑度之否</color>狀態，將轉為施放元素爆發<color=#FFD780FF>黑度法·如星陰燃</color>，對前方的敵人造成三次<color=#FF9999FF>火元素範圍傷害</color>，並將自身的力量以<color=#FFD780FF>「黑蝕之龍」</color>的形態顯現。「黑蝕之龍」將跟隨目前場上角色，並間歇性對周圍一名敵人發起攻擊，造成<color=#FF9999FF>火元素傷害</color>，該傷害視為元素爆發傷害。\\n\\n此外，若杜林不處於精質轉變的特殊狀態，將施放元素爆發<color=#FFD780FF>白化法·如光流變</color>。","descriptionBuff":null,"icon":"Skill_E_Durin_01","promote":{"1":{"level":1,"costItems":null,"coinCost":null,"description":["白化法·如光流變傷害|{param1:F1P}+{param2:F1P}+{param3:F1P}","黑度法·如星陰燃傷害|{param4:F1P}+{param5:F1P}+{param6:F1P}","白焰之龍傷害|{param7:F1P}","黑蝕之龍傷害|{param8:F1P}","白焰之龍持續時間|{param9:F1}秒","黑蝕之龍持續時間|{param10:F1}秒","冷卻時間|{param11:F1}秒","元素能量|{param12:I}","","","","","","","","","","","",""],"params":[1.1896,0.964,1.1184,1.2544,1.0176,1.1184,0.9464,1.2984,20,20,18,70,0,0,0,0,0,0,0,0]},"2":{"level":2,"costItems":{"104307":3,"112125":6},"coinCost":12500,"description":["白化法·如光流變傷害|{param1:F1P}+{param2:F1P}+{param3:F1P}","黑度法·如星陰燃傷害|{param4:F1P}+{param5:F1P}+{param6:F1P}","白焰之龍傷害|{param7:F1P}","黑蝕之龍傷害|{param8:F1P}","白焰之龍持續時間|{param9:F1}秒","黑蝕之龍持續時間|{param10:F1}秒","冷卻時間|{param11:F1}秒","元素能量|{param12:I}","","","","","","","","","","","",""],"params":[1.27882,1.0363,1.20228,1.