:"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Normal Attack 4-Hit","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"72.03","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":false},{"name":"Charged Attack","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Charged Attack"},"type":{"span":null,"text":"0.5s"}},"interruptionResistance":"120","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"480","verticalForce":"600"},"bluntAttack":false},{"name":"Plunging Attack Collision","elementalGaugeTheory":"0U","internalCooldown":null,"interruptionResistance":"25","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Low Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"100","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"High Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"150","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"0","verticalForce":"800"},"bluntAttack":true}]},"1":{"skillId":11002,"type":0,"name":"出擊，沖天轉轉！","description":"和超可靠的沖天轉轉一同戰鬥！\\n召喚「沖天轉轉」；長按施放時，卡齊娜將召喚並搭乘沖天轉轉。\\n施放後，卡齊娜將獲得60點夜魂值並進入夜魂加持狀態。\\n\\n<color=#FFD780FF>夜魂加持·卡齊娜</color>\\n沖天轉轉的各種行為將消耗夜魂值。\\n夜魂值耗盡時卡齊娜的夜魂加持將會結束。\\n\\n<color=#FFD780FF>沖天轉轉</color>\\n能夠獨立存在，或是由卡齊娜搭乘操控。沖天轉轉存在時，卡齊娜的元素戰技「出擊，沖天轉轉！」將替換為搭乘或脫離沖天轉轉。\\n·沖天轉轉獨立存在時，將間歇性衝擊地面，基於卡齊娜的防禦力，造成具有夜魂性質的<color=#FFE699FF>岩元素範圍傷害</color>。\\n·卡齊娜搭乘沖天轉轉時，能操控沖天轉轉快速移動、攀爬，並在進行普通攻擊時衝擊地面，基於卡齊娜的防禦力，造成具有夜魂性質的<color=#FFE699FF>岩元素範圍傷害</color>。\\n\\n沖天轉轉將在卡齊娜的夜魂加持結束時消失，被視為岩元素創造物；同時只能存在一個卡齊娜自己的沖天轉轉。\\n\\n<i>「沖天轉轉」只是看起來像陀螺，其實是能夠鑽破堅固岩石的鑽頭。</i>","descriptionBuff":null,"icon":"Skill_S_Kachina_01","promote":{"1":{"level":1,"costItems":null,"coinCo