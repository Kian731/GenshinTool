alForce":"0"},"bluntAttack":false},{"name":"DoT","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Elemental Burst"},"type":{"span":null,"text":"2.5s/3 Hits"}},"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":5321,"type":2,"name":"更加合適的人選","description":"早柚在場上觸發擴散或星擴散反應時，為隊伍中自己的角色以及附近的友方角色恢復300點生命值。除此之外，早柚的每點元素精通將額外恢復1.2點生命值。\\n該效果每2秒只能觸發一次。","descriptionBuff":"","icon":"UI_Talent_S_Sayu_05","linkedConstellations":null},"5":{"skillId":5322,"type":2,"name":"早柚不用工作啦","description":"<color=#FFD780FF>嗚呼流·影貉繚亂</color>的不倒貉貉獲得如下效果：\\n·為角色恢復生命值時，將為該角色身邊的其他場上角色恢復相當於回復量20%的生命值。\\n·攻擊敵人時，擴大造成傷害的範圍。","descriptionBuff":"","icon":"UI_Talent_S_Sayu_06","linkedConstellations":null},"6":{"skillId":5323,"type":2,"name":"嗚呼流·屏息秘傳","description":"早柚在隊伍中時，隊伍中自己的角色接近晶蝶等部分生物時，不會驚動牠們。\\n有效對象可參考圖鑑中「生物誌 / 野生動物」的「其他」分類。","descriptionBuff":"","icon":"UI_Talent_S_Sayu_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":531,"name":"一心二用之術","description":"<color=#FFD780FF>嗚呼流·影貉繚亂</color>的不倒貉貉的行動將忽視生命值限制，能同時攻擊附近的敵人並為角色恢復生命值。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sayu_01"},"1":{"id":1,"talentId":532,"name":"理清逃跑路線","description":"<color=#FFD780FF>嗚呼流·風隱急進</color>獲得如下效果：\\n·點按施放時，風風輪舞踢造成的傷害提高3.3%。\\n·處於長按施放後的風風輪狀態下時，每0.5秒，就會使這次施展的風風輪舞踢造成的傷害提高3.3%。透過這種方式，風風輪舞踢造成的傷害至多可以提高66%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sayu_02"},"2":{"id":2,"talentId":533,"name":"都交給分身吧","description":"<color=#FFD780FF>嗚呼流·影貉繚亂</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Sayu_02"},"3":{"id":3,"talentId":534,"name":"偷懶的新方法","description":"早柚在場上觸發擴散或星擴散反應時，將恢復1.2點元素能量。\\n該效果每2秒只能觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sayu_03"},"4":{"id":4,"talentId":535,"name":"快是第一奧義","description":"<color=#FFD780FF>嗚呼流·風隱急進</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Sayu_01"},"5":{"id":5,"talentId":536,"name":"呼呼大睡時間","description":"早柚自己透過<color=#FFD780FF>嗚呼流·影貉繚亂</color>召喚的不倒貉貉的攻擊與回復量，受益於早柚的元素精通。早柚的每點元素精通，能產生如下效果：\\n·使不倒貉貉的攻擊額外造成0.2%攻擊力的傷害。透過這種方式至多額外造成400%攻擊力的傷害；\\n·使不倒貉貉的回復量提高3點。透過這種方式，至多提高6000點回復量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sayu_04"}},"dictionary":null}}