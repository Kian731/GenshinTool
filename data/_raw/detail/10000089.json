00","verticalForce":"0"},"bluntAttack":false},{"name":"Low Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"100","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"High Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"150","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"0","verticalForce":"800"},"bluntAttack":true}]},"1":{"skillId":10892,"type":0,"name":"孤心沙龍","description":"邀請孤心沙龍的客人們上陣，為芙寧娜的演出助興。根據芙寧娜目前的<color=#FFD780FF>始基力屬性</color>，邀請的客人分為「沙龍成員」與「眾水的歌者」。\\n\\n<color=#FFD780FF>荒性</color>\\n揮灑歡慶的泡沫，基於芙寧娜的生命值上限，造成<color=#80C0FFFF>水元素範圍傷害</color>，並召喚三位「沙龍成員」：球球章魚形態的「烏瑟勳爵」、泡泡海馬形態的「海薇瑪夫人」和重甲蟹形態的「謝貝蕾妲小姐」。\\n「沙龍成員」將間歇性攻擊附近的敵人，並優先攻擊目前場上角色的目標，基於生命值上限，造成<color=#80C0FFFF>水元素傷害</color>。\\n「沙龍成員」進行攻擊時，根據附近的隊伍中生命值高於50%的角色數量，提升此次攻擊的威力，並消耗這些角色的生命值：滿足條件的角色數量為1/2/3/4名或更多時，攻擊造成的傷害為原本的110%/120%/130%/140%。\\n\\n<color=#FFD780FF>芒性</color>\\n召喚「眾水的歌者」，每隔一段時間，受益於生命值上限，為周圍的目前場上角色恢復生命值。\\n\\n「沙龍成員」與「眾水的歌者」共享持續時間，芙寧娜透過重擊更換客人的陣容時，將繼承持續時間。\\n「沙龍成員」或「眾水的歌者」存在期間，芙寧娜能夠在水面上移動。\\n\\n<i>芙寧娜的孤心沙龍總有固定成員到訪。其他時候都是謝貝蕾妲小姐、海薇瑪夫人和烏瑟勳爵，而憂鬱的星期三出現的則是歌者。</i>","descriptionBuff":null,"icon":"Skill_S_Furina_01","promote":{"1":{"level":1,"costItems":null,"coinCost":null,"description":["荒性泡沫傷害|{param1:F1P}生命值上限","持續時間|{param2:F1}秒","烏瑟勳爵傷害|{param3:F2P}生命值上限","海薇瑪夫人傷害|{param4:F2P}生命值上限","謝貝蕾妲小姐傷害|{param5:F2P}生命值上限","烏瑟勳爵消耗生命值|{param6:F1P}生命值上限","海薇瑪夫人消耗生命值|{param7:F1P}生命值上限","謝貝蕾妲小姐消耗生命值|{param8:F1P}生命值上限","眾水的歌者治療量|{param9:F2P}生命值上限+{param10:I}","冷卻時間|{param11:F1}秒","","","","","","","","","",""],"params":[0.07864,30,0.0596,0.03232,0.08288,0.024,0.016,0.036,0.048,462.2253,20,0,0,0,0,0,0,0,0,0]},"2":{"level":2,"costItems":{"104341":3,"112038":6},"coinCost":12500,"description":["荒性泡沫傷害|{param1:F1P}生命值上限","持續時間|{param2:F1}秒","烏瑟勳爵傷害|{param3:F2P}生命值上限","海薇瑪夫人傷害|{param4:F2P}生命值上限","謝貝蕾妲小姐傷害|{param5:F2P}生命值上限","烏瑟勳爵消耗生命值|{param6:F1P}生命值上限","海薇瑪