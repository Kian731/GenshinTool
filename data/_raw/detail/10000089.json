vancedProps":[{"name":"Skill DMG","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"120","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":8921,"type":2,"name":"停不了的圓舞","description":"隊伍中目前場上的角色受到治療時，若這次治療的來源不是芙寧娜自己並且治療回復量溢出，在接下來的4秒內，芙寧娜每2秒將為隊伍中附近的角色恢復一次生命值，回復量相當於角色各自生命值上限的2%。","descriptionBuff":"","icon":"UI_Talent_S_Furina_05","linkedConstellations":null},"5":{"skillId":8922,"type":2,"name":"無人聽的自白","description":"每1000點生命值上限都將使處於不同始基力屬性下的芙寧娜的<color=#FFD780FF>孤心沙龍</color>獲得相應的增益效果：\\n「沙龍成員」造成的傷害提升0.7%，依此方式至多使「沙龍成員」造成的傷害提升28%；\\n「眾水的歌者」為周圍的目前場上角色恢復生命值的間隔降低0.4%，依此方式至多使「眾水的歌者」為周圍的目前場上角色恢復生命值的間隔降低16%。","descriptionBuff":"","icon":"UI_Talent_S_Furina_06","linkedConstellations":null},"6":{"skillId":8923,"type":2,"name":"瀚海亦舞臺","description":"異色原海異種能力的冷卻時間降低30%。","descriptionBuff":"","icon":"UI_Talent_S_Furina_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":891,"name":"「愛是難馴鳥，哀乞亦無用。」","description":"施放<color=#FFD780FF>萬眾狂歡</color>時，芙寧娜獲得150點「氣氛值」。\\n此外，芙寧娜持有「氣氛值」的上限提升100點。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Furina_01"},"1":{"id":1,"talentId":892,"name":"「女人皆善變，彷若水中萍。」","description":"<color=#FFD780FF>萬眾狂歡</color>持續期間，芙寧娜透過隊伍中附近角色的目前生命值提升或降低的方式獲得的「氣氛值」提升250%。基於「氣氛值」超過上限的部分，每1點「氣氛值」都將使芙寧娜的生命值上限提升0.35%。至多依此方式使芙寧娜的生命值上限提升140%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Furina_04"},"2":{"id":2,"talentId":893,"name":"「秘密藏心間，無人知我名。」","description":"<color=#FFD780FF>萬眾狂歡</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Furina_02"},"3":{"id":3,"talentId":894,"name":"「若非處幽冥，怎知生可貴！」","description":"<color=#FFD780FF>孤心沙龍</color>的「沙龍成員」命中敵人，或「眾水的歌者」為周圍的目前場上角色恢復生命值時，芙寧娜獲得4點元素能量，該效果每5秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Furina_03"},"4":{"id":4,"talentId":895,"name":"「我已有覺察，他名即是…！」","description":"<color=#FFD780FF>孤心沙龍</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Furina_01"},"5":{"id":5,"talentId":896,"name":"「諸君聽我頌，共舉愛之杯！」","description":"施放<color=#FFD780FF>孤心沙龍</color>時，芙寧娜將獲得「萬眾矚目」，持續10秒。\\n持續期間，芙寧娜的普通攻擊、重擊與下落攻擊將轉為無法被附魔覆蓋的<color=#80C0FFFF>水元素傷害</color>，且造成的傷害提升，提升值相當於芙寧娜生命值上限的18%。\\n持續期間，每0.1秒，芙寧娜的普通攻擊（不包括「始基力：聖俗雜座」的攻擊）、重擊與下落攻擊墜地衝擊命中敵人後，將根據芙寧娜目前的始基力屬性產生不同的效果：\\n\\n始基力：荒性\\n每1秒，基於芙寧娜生命值上限的4%，為附近的隊伍中所有角色恢復生命值，持續2.9秒，重複觸發將延長持續時間。\\n始基力：芒性\\n本次普通攻擊（不包括「始基力：聖俗雜座」的攻擊）、重擊與下落攻擊墜地衝擊造成的傷害進一步提高，提升值相當於芙寧娜生命值上限的25%，上述攻擊命中敵人時，附近的隊伍中所有角色將消耗相當於目前生命值1%的生命值。\\n\\n一次「萬眾矚目」持續期間，上述效果至多觸發6次，該效果將在觸發次數達到6次或持續時間結束時解除。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Furina_02"}},"dictionary":null}}