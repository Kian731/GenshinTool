linkedConstellations":null},"5":{"skillId":14822,"type":2,"name":"告別冬麥與殘葉","description":"基於阿羅夏的元素充能效率，提升阿羅夏的元素戰技與元素爆發造成的傷害：每1%元素充能效率都會使上述傷害提升0.35%，至多提升至70%。","descriptionBuff":"","icon":"UI_Talent_S_Alyosha_06","linkedConstellations":null},"6":{"skillId":14823,"type":2,"name":"星赴險域","description":"處於{LINK#N11330003}<color=#FFD780FF>極星輝域</color>{/LINK}中時，阿羅夏將會進入<color=#FFD780FF>輝映·星超導</color>狀態。\\n<color=#FFD780FF>輝映·星超導</color>：啟動{LINK#N11480001}<color=#FFD780FF>弋獵印記</color>{/LINK}時獲得的<color=#FFD780FF>獵者之準</color>效果還會使角色處於場上時造成的星超導反應傷害提升20%。","descriptionBuff":"","icon":"UI_Talent_S_Alyosha_07","effects":["N11330003","N11480001"],"linkedConstellations":null},"8":{"skillId":14825,"type":2,"name":"樹梢察伺","description":"在小地圖上顯示周圍的<color=#FFD780FF>至冬區域特產</color>的位置。","descriptionBuff":"","icon":"UI_Talent_S_Alyosha_08","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":1481,"name":"寒谷轟雷","description":"隊伍中附近的角色對敵人觸發<color=#FFACFFFF>雷元素相關反應</color>後，將為阿羅夏恢復15點元素能量，該效果每18秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Alyosha_01"},"1":{"id":1,"talentId":1482,"name":"長嗥遠訊","description":"元素爆發<color=#FFD780FF>守獵進踞</color>的持續時間延長6秒。\\n此外，{LINK#N11480002}<color=#FFD780FF>圖加林</color>{/LINK}每次攻擊敵人前，還會為一名目標施加{LINK#N11480001}<color=#FFD780FF>弋獵印記</color>{/LINK}。該效果不會啟動已有的<color=#FFD780FF>弋獵印記</color>。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Alyosha_02","effects":["N11480002","N11480001"]},"2":{"id":2,"talentId":1483,"name":"僚朋相喚","description":"元素戰技<color=#FFD780FF>伏襲霆擊</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Alyosha_01"},"3":{"id":3,"talentId":1484,"name":"銜取獵品","description":"{LINK#N11480002}<color=#FFD780FF>圖加林</color>{/LINK}進行攻擊時，還會為隊伍中附近的生命值百分比最低的角色恢復生命值，回復量相當於阿羅夏攻擊力的60%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Alyosha_03","effects":["N11480002"]},"4":{"id":4,"talentId":1485,"name":"鶯啼止時","description":"元素爆發<color=#FFD780FF>守獵進踞</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Alyosha_02"},"5":{"id":5,"talentId":1486,"name":"復奪旌幡","description":"啟動{LINK#N11480001}<color=#FFD780FF>弋獵印記</color>{/LINK}時獲得的<color=#FFD780FF>獵者之準</color>效果可以疊加。該效果至多疊加2層，疊加至2層時，還會使處於該效果影響下的目前場上角色的元素精通提升100點。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Alyosha_04","effects":["N11480001"]}},"dictionary":{"talent":["N11480001","N11480002","N11330003"],"constellation":["N11480002","N11480001"],"effectsInfo":{"N11480001":{"id":11480001,"name":"弋獵印記","description":"阿羅夏向敵人施加的特殊效果。\\n對已經處於<color=#FFD780FF>弋獵印記</color>影響下的敵人再次施加該效果時，將會改為啟動<color=#FFD780FF>弋獵印記</color>：移除該印記，並使隊伍中附近的所有角色獲得<color=#FFD780FF>獵者之準</color>效果：處於場上時，攻擊力提升。","params":null,"props":["","","","",""]},"N11480002":{"id":11480002,"name":"圖加林","description":"深受阿羅夏信賴的獵犬夥伴，可以透過施放元素爆發<color=#FFD780FF>守獵進踞</color>召喚至場上，會間歇性快速移動至一名敵人附近，對其進行撕咬攻擊，並啟動已有的<color=#FFD780FF>弋獵印記</color>。","params":null,"props":["","","","",""]},"N11330003":{"id":11330003,"name":"極星輝域","description":"觸發星超導反應時，附近的區域會短暫變化為<color=#FFD780FF>極星輝域</color>。處於極星輝域中時，特定角色將會進入<color=#FFD780FF>輝映·星超導</color>狀態，使其不同技能分別獲得對應的強化效果。","params":null,"props":["","","","",""]}}}}}