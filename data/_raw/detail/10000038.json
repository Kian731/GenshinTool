interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"Fatal Blossom DMG","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Elemental Burst"},"type":{"span":null,"text":"2.5s/3 Hits"}},"interruptionResistance":"30","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":true}]},"4":{"skillId":3821,"type":2,"name":"白堊色的威壓","description":"<color=#FFD780FF>創生法·擬造陽華</color>的刹那之花對生命值低於50%的敵人造成的傷害提高25%。","descriptionBuff":"元素戰技<color=#FFD780FF>創生法·擬造陽華</color>中，由陽華生成的剎那之花對生命值低於50%的敵人造成的傷害提高25%。\\n此外，若場上存在由阿貝多自己創造的瑰銀，還會提升本次造成的傷害，提升值相當於阿貝多防禦力的240%。","icon":"UI_Talent_S_Albedo_05","linkedConstellations":null},"5":{"skillId":3822,"type":2,"name":"瓶中人的天慧","description":"施放<color=#FFD780FF>誕生式·大地之潮</color>時，使附近的隊伍中角色的元素精通提高125點，持續10秒。","descriptionBuff":"","icon":"UI_Talent_S_Albedo_06","linkedConstellations":null},"6":{"skillId":3823,"type":2,"name":"天才的發現","description":"合成武器突破素材時，有10%機率獲得兩倍產出。","descriptionBuff":"","icon":"UI_Talent_Combine_Weapon_Double","linkedConstellations":null},"9":{"skillId":3851,"type":2,"name":"魔女的前夜禮·白芒之書","description":"完成<color=#FFD780FF>魔女的課業·題外之題</color>後，阿貝多將成為<color=#FFD780FF>魔導</color>角色。隊伍中編入至少2名魔導角色時，將獲得<color=#FFD780FF>魔導·秘儀</color>效果，使魔導角色獲得強化。\\n\\n<color=#FFD780FF>魔導·秘儀</color>\\n·施放元素戰技後的20秒內，阿貝多的元素戰技命中敵人時，將會在敵人附近煉成<color=#FFD780FF>瑰銀</color>，持續10秒。場上不存在阿貝多自己創造的陽華時，如果阿貝多沒有倒下，一枚瑰銀將會獲得與陽華相同的生成剎那之花的效果。同時只能存在兩個由阿貝多自己創造的瑰銀。\\n·煉成陽華後的20秒內，基於阿貝多的防禦力，提升隊伍中附近的角色的普通攻擊、重擊、下落攻擊、元素戰技和元素爆發造成的傷害：每1000點防禦力都將提升4%傷害，至多依此方式提升12%傷害。\\n·煉成瑰銀後的20秒內，基於阿貝多的防禦力，提升隊伍中附近的魔導角色的普通攻擊、重擊、下落攻擊、元素戰技和元素爆發造成的傷害：每1000點防禦力都將提升10%傷害，至多依此方式提升30%傷害。","descriptionBuff":"","icon":"UI_Talent_S_Albedo_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":381,"name":"伊甸之花","description":"阿貝多的<color=#FFD780FF>創生法·擬造陽華</color>生成的刹那之花綻放時，為阿貝多自身回復1.2點元素能量。","descriptionBuff":"阿貝多的元素戰技<color=#FFD780FF>創生法·擬造陽華</color>中，由陽華生成的剎那之花綻放時，為阿貝多自己回復1.2點元素能量。\\n此外，阿貝多施放元素戰技<color=#FFD780FF>創生法·擬造陽華</color>後的20秒內，自身的防禦力提升50%。","extraData":null,"icon":"UI_Talent_S_Albedo_01"},"1":{"id":1,"talentId":382,"name":"顯生之宙","description":"<color=#FFD780FF>創生法·擬造陽華</color>的刹那之花綻放時，會為阿貝多賦予生滅計數效果，持續30秒。\\n·施放<color=#FFD780FF>誕生式·大地之潮</color>時，清除所有生滅計數效果，並根據清除的層數提高誕生式·大地之潮的爆發傷害與生滅之花的傷害。\\n·每層生滅計數提高等同於阿貝多防禦力30%的傷害。\\n·該效果至多疊加四層。","descriptionBuff":"元素戰技<color=#FFD780FF>創生法·擬造陽華</color>中的剎那之花綻放時，會為阿貝多賦予生滅計數效果，持續30秒：\\n·施放元素爆發<color=#FFD780FF>誕生式·大地之潮</color>時，清除所有生滅計數效果，並根據清除的層數，提高誕生式·大地之潮的爆發傷害與生滅之花造成的傷害。\\n·每層生滅計數，會提高等同於阿貝多防禦力的30%的傷害。\\n·該效果至多疊加4次。\\n\\n此外，當阿貝多處於後臺且生滅計數疊加至4層時，將清除所有生滅計數效果，並在目前場上自己的角色附近生成3朵生滅之花，猛烈綻放並造成<color=#FFE699FF>岩元素範圍傷害</color>，該傷害基於阿貝多防禦力的300%，並視為元素爆發傷害。解鎖固有天賦{LINK#P382201}<color=#FFD780FF>「瓶中人的天慧」</color>{/LINK}後，還會觸發該固有天賦中的效果，使附近的隊伍中角色的元素精通提升125點，持續10秒。","extraData":null,"icon":"UI_Talent_S_Albedo_02"},"2":{"id":2,"talentId":383,"name":"太陽之華","description":"<color=#FFD780FF>創生法·擬造陽華</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Albedo_01"},"3":{"id":3,"talentId":384,"name":"神性之隕","description":"處於陽華的領域中的隊伍中目前場上角色，造成的下落攻擊傷害提高30%。","descriptionBuff":"處於陽華的領域中的隊伍中目前場上角色，下落攻擊造成的傷害提高30%。\\n此外，隊伍中附近的目前場上角色在瑰銀附近跳躍時，將會摧毀瑰銀，大幅提升本次跳躍的高度，並在接下來的3秒內，使該角色的下落攻擊墜地衝擊造成的傷害提升30%。該效果將在下落攻擊墜地衝擊造成傷害後的0.1秒後解除。","extraData":null,"icon":"UI_Talent_S_Albedo_03"},"4":{"id":4,"talentId":385,"name":"冥古之潮","description":"<color=#FFD780FF>誕生式·大地之潮</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Albedo_02"},"5":{"id":5,"talentId":386,"name":"無垢之土","description":"處在陽華的領域中的隊伍中目前場上角色，若處於結晶反應產生的護盾庇護下，或陽華的領域中存在月籠時，造成的傷害提高17%。","descriptionBuff":"處於陽華的領域中的隊伍中目前場上角色，若處於結晶反應產生的護盾庇護下，或陽華的領域中存在月籠時，造成的傷害提升17%。\\n此外，施放元素爆發<color=#FFD780FF>誕生式·大地之潮</color>時，還會摧毀場上所有的瑰銀。依此方式摧毀瑰銀時，本次元素爆發將會視為清除了4層命之座{LINK#TE382}<color=#FFD780FF>顯生之宙</color>{/LINK}中的生滅計數，並在接下來的20秒內，使生滅之花造成的傷害提升，提升值相當於阿貝多防禦力的250%。","extraData":null,"icon":"UI_Talent_S_Albedo_04"}},"dictionary":null,"buff":true}}