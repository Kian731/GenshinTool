lse,"prop":[{"id":4,"type":"normal"}]},"advancedProps":[{"name":"Skill DMG","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"100","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Arcane Projection DMG","elementalGaugeTheory":"0U","internalCooldown":null,"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":13121,"type":2,"name":"分有","description":"施放元素戰技<color=#FFD780FF>{LINK#S11312}聖言默示·未現之光{/LINK}</color>後的20秒內，尼可將持續「觀測」隊伍中自己的目前場上其他角色。受觀測的角色持續處於場上3秒後，其擁有的{LINK#N11310001}<color=#FFD780FF>虛己之賜</color>{/LINK}效果將會升變為{LINK#N11310002}<color=#FFD780FF>聖祝之引</color>{/LINK}，使其額外提升300點攻擊力。若受觀測的角色為魔導角色，則<color=#FFD780FF>虛己之賜</color>效果將會直接升變為<color=#FFD780FF>聖祝之引</color>。\\n除尼可外，其他角色擁有的<color=#FFD780FF>聖祝之引</color>將在退場時還原為<color=#FFD780FF>虛己之賜</color>。","descriptionBuff":"","icon":"UI_Talent_S_Nicole_05","effects":["N11310001","N11310002"],"linkedConstellations":null},"5":{"skillId":13122,"type":2,"name":"慕善","description":"隊伍中附近的目前場上角色的元素傷害命中敵人後，尼可自己擁有的{LINK#N11310001}<color=#FFD780FF>虛己之賜</color>{/LINK}將會升變為{LINK#N11310002}<color=#FFD780FF>聖祝之引</color>{/LINK}，持續8秒。","descriptionBuff":"","icon":"UI_Talent_S_Nicole_06","effects":["N11310001","N11310002"],"linkedConstellations":null},"6":{"skillId":13123,"type":2,"name":"靜念","description":"在提瓦特，不處於戰鬥狀態下時，若已獲得目前區域的尋寶羅盤，則尼可的重擊將會轉而施放「御使之引」：呼喚附近的仙靈指引道路，觸發等同於目前區域尋寶羅盤的效果。\\n該效果有5秒的冷卻時間，且在秘境、征討領域、深境螺旋中無效。","descriptionBuff":"","icon":"UI_Talent_S_Nicole_08","linkedConstellations":null},"9":{"skillId":13151,"type":2,"name":"魔女的前夜禮·光自暗來","description":"完成<color=#FFD780FF>魔女的課業·導引之職…？</color>後，尼可將成為<color=#FFD780FF>魔導</color>角色。隊伍中編入至少2名魔導角色時，將獲得<color=#FFD780FF>魔導·秘儀</color>效果，使魔導角色獲得強化。\\n\\n<color=#FFD780FF>魔導·秘儀</color>\\n魔導角色的<color=#FFD780FF>{LINK#S11315}奧跡造影{/LINK}</color>造成的傷害提升，提升值相當於尼可攻擊力的300%。","descriptionBuff":"","icon":"UI_Talent_S_Nicole_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":1311,"name":"「不要懼怕，蒙眷愛的人之子呀」","description":"隊伍中自己的目前場上角色攻擊命中敵人時，將會額外召喚出特殊的「奧跡造影·合一」，對敵人進行協同攻擊，依據該角色的元素類型，造成對應元素範圍傷害，該傷害相當於該角色攻擊力的600%，並視為由該角色造成的傷害。\\n該效果每6秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Nicole_01"},"1":{"id":1,"talentId":1312,"name":"「我要教導你，指引你應走的路」","description":"元素戰技<color=#FFD780FF>{LINK#S11312}聖言默示·未現之光{/LINK}</color>的效果獲得強化：{LINK#N11310001}<color=#FFD780FF>虛己之賜</color>{/LINK}還會額外提升300點攻擊力（不計入該效果的攻擊力加成上限），{LINK#N11310002}<color=#FFD780FF>聖祝之引</color>{/LINK}還會依據角色的元素類型，使附近敵人的對應元素抗性降低25%，同元素類型的元素抗性降低效果不能疊加。\\n此外，尼可施放元素戰技<color=#FFD780FF>聖言默示·未現之光</color>時，也會為附近的目前場上角色賦予熾光護盾。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Nicole_02","effects":["N11310001","N11310002"]},"2":{"id":2,"talentId":1313,"name":"「為你身邊的燈，為你前方的光」","description":"元素戰技<color=#FFD780FF>{LINK#S11312}聖言默示·未現之光{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Nicole_01"},"3":{"id":3,"talentId":1314,"name":"「向左或向右，無論你行往何方」","description":"隊伍中附近的角色擁有的{LINK#N11310001}<color=#FFD780FF>虛己之賜</color>{/LINK}升變為{LINK#N11310002}<color=#FFD780FF>聖祝之引</color>{/LINK}時，尼可還會為其賦予「先導之佑」效果，持續20秒，每名角色每16秒至多獲得一次該效果。\\n擁有「先導之佑」的角色的普通攻擊、重擊、下落攻擊、元素戰技與元素爆發造成的傷害提升，提升值相當於尼可攻擊力的70%。該效果將在生效8次或持續時間結束時解除。\\n同時命中多名敵人時，會依據命中敵人的數量消耗生效次數。隊伍中具有「先導之佑」的角色，其生效次數單獨計算。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Nicole_03","effects":["N11310001","N11310002"]},"4":{"id":4,"talentId":1315,"name":"「我就要有話對你說，在你身旁」","description":"元素爆發<color=#FFD780FF>{LINK#S11315}聖言默示·天路歷程{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Nicole_02"},"5":{"id":5,"talentId":1316,"name":"「這便是正確的道路，莫要彷徨」","description":"尼可擁有的{LINK#N11310001}<color=#FFD780FF>虛己之賜</color>{/LINK}升變為{LINK#N11310002}<color=#FFD780FF>聖祝之引</color>{/LINK}時，隊伍中附近的所有角色擁有的<color=#FFD780FF>虛己之賜</color>將會一同升變為<color=#FFD780FF>聖祝之引</color>。所有升變後的<color=#FFD780FF>聖祝之引</color>不再會還原為<color=#FFD780FF>虛己之賜</color>。\\n此外，擁有<color=#FFD780FF>聖祝之引</color>的角色造成的傷害將無視敵人40%的防禦力。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Nicole_04","effects":["N11310001","N11310002"]}},"dictionary":{"talent":["N11310001","N11310002"],"constellation":["N11310001","N11310002"],"effectsInfo":{"N11310001":{"id":11310001,"name":"虛己之賜","description":"施放元素戰技<color=#FFD780FF>聖言默示·未現之光</color>後，尼可會為隊伍中附近的所有角色賦予該效果：基於尼可的攻擊力，提升攻擊力。\\n滿足特定條件後，<color=#FFD780FF>虛己之賜</color>效果將會升變為<color=#FFD780FF>聖祝之引</color>，進一步提升攻擊力。","params":null,"props":["","","","",""]},"N11310002":{"id":11310002,"name":"聖祝之引","description":"<color=#FFD780FF>虛己之賜</color>升變後的效果，能額外提升{PARAM#P1312101|3S1}點攻擊力。\\n解鎖突破天賦「分有」並滿足其中的任意「觀測」條件後，<color=#FFD780FF>虛己之賜</color>將會在剩餘持續時間內升變為<color=#FFD780FF>聖祝之引</color>：\\n·受觀測的其他角色持續處於場上超過{PARAM#P1312101|2S1}秒。\\n·受觀測的其他角色為魔導角色。\\n\\n此外，解鎖突破天賦「慕善」後，隊伍中附近的目前場上角色的元素傷害命中敵人後，尼可自己擁有的<color=#FFD780FF>虛己之賜</color>也會升變為<color=#FFD780FF>聖祝之引</color>，持續{PARAM#P1312201|1S1}秒。\\n\\n除尼可外，其他角色擁有的<color=#FFD780FF>聖祝之引</color>將在退場時還原為<color=#FFD780FF>虛己之賜</color>。","params":[{"skillFull":"P1312101|3S1","skillId":1312101,"skillParam":{"paramNum":2,"paramValue":300,"paramMultiplier":1}},{"skillFull":"P1312101|2S1","skillId":1312101,"skillParam":{"paramNum":1,"paramValue":3,"paramMultiplier":1}},{"skillFull":"P1312201|1S1","skillId":1312201,"skillParam":{"paramNum":0,"paramValue":8,"paramMultiplier":1}}],"props":["","","","",""]}}}}}