ext":"Elemental Burst"},"type":{"span":null,"text":"2.5s/3 Hits"}},"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":9821,"type":2,"name":"破夜的明焰","description":"隊伍中附近的角色對敵人觸發<color=#FFACFFFF>雷元素相關反應</color>後，將基於克洛琳德攻擊力的20%，提升克洛琳德的普通攻擊與<color=#FFD780FF>殘光將終</color>造成的<color=#FFACFFFF>雷元素傷害</color>。此效果持續15秒，至多疊加3層，每層獨立計時。依此方式至多使克洛琳德的上述攻擊造成的傷害提升1800。","descriptionBuff":"","icon":"UI_Talent_S_Clorinde_05","linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":1,"type":"normal"}]}},"5":{"skillId":9822,"type":2,"name":"契令的酬償","description":"如果克洛琳德的生命之契大於或等於生命值上限的100%，生命之契的數值提升或降低時，克洛琳德的暴擊率提升10%，此效果持續15秒，至多疊加2層，每層獨立計時。\\n此外，<color=#FFD780FF>狩夜之巡</color>的夜巡狀態獲得強化：持續期間，治療回復量轉化為生命之契的比例提升至100%。","descriptionBuff":"","icon":"UI_Talent_S_Clorinde_06","linkedConstellations":null},"6":{"skillId":9823,"type":2,"name":"夜巡之穫","description":"在小地圖上顯示周圍的<color=#FFD780FF>楓丹區域特產</color>的位置。","descriptionBuff":"","icon":"UI_Talent_S_Liney_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":981,"name":"「自此，行過燭影之帷」","description":"<color=#FFD780FF>狩夜之巡</color>的夜巡狀態持續期間，克洛琳德的普通攻擊造成的<color=#FFACFFFF>雷元素傷害</color>命中敵人時，將在敵人附近喚出夜巡之影進行兩次協同攻擊，各自造成克洛琳德30%攻擊力的<color=#FFACFFFF>雷元素傷害</color>。\\n此效果每1.2秒至多觸發一次，依此方式造成的傷害視為普通攻擊傷害。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Clorinde_01","advancedProps":[{"name":"Coordinated Attack","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"C1/C6"},"type":{"span":null,"text":"1s"}},"interruptionResistance":"25","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"1":{"id":1,"talentId":982,"name":"「自此，直面長夜之危」","description":"突破天賦「破夜的明焰」的效果獲得強化：隊伍中附近的角色對敵人觸發<color=#FFACFFFF>雷元素相關反應</color>後，將基於克洛琳德攻擊力的30%，提升克洛琳德的普通攻擊與<color=#FFD780FF>殘光將終</color>造成的<color=#FFACFFFF>雷元素傷害</color>。此效果持續15秒，至多疊加3層，每層獨立計時。處於3層狀態下時，克洛琳德的抗打斷能力提升。依此方式至多使克洛琳德的上述攻擊造成的傷害提升2700。\\n需要解鎖突破天賦「破夜的明焰」。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Clorinde_02"},"2":{"id":2,"talentId":983,"name":"「我將銘記白晝的誓言」","description":"<color=#FFD780FF>狩夜之巡</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Clorinde_02"},"3":{"id":3,"talentId":984,"name":"「銘記淚、生命與仁愛」","description":"<color=#FFD780FF>殘光將終</color>對敵人造成傷害時，將根據克洛琳德的目前生命之契百分比提升此次傷害，每1%生命之契都將使此次<color=#FFD780FF>殘光將終</color>造成的傷害提升2%；依此方式，至多使<color=#FFD780FF>殘光將終</color>造成的傷害提升200%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Clorinde_03"},"4":{"id":4,"talentId":985,"name":"「也銘記黎明終將到來」","description":"<color=#FFD780FF>殘光將終</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Clorinde_01"},"5":{"id":5,"talentId":986,"name":"「為此，勿將希望揚棄」","description":"施放<color=#FFD780FF>狩夜之巡</color>後的12秒內，克洛琳德的暴擊率提升10%，暴擊傷害提升70%。\\n此外，夜巡狀態持續期間，明燭之影會在特定條件下出現，進行追擊，造成克洛琳德200%攻擊力的<color=#FFACFFFF>雷元素傷害</color>，依此方式造成的傷害視為普通攻擊傷害。\\n明燭之影會在如下情況下出現：\\n·克洛琳德即將被攻擊命中時。\\n·克洛琳德進行貫夜·契令時。\\n每1秒至多透過上述方式喚出1次明燭之影，一次夜巡狀態持續期間，至多喚出6次明燭之影。\\n此外，夜巡狀態持續期間，克洛琳德受到的傷害降低80%，抗打斷能力提高，該效果將在夜巡狀態結束或喚出6次明燭之影的1秒後移除。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Clorinde_04","advancedProps":[{"name":"Glimbright Shade","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"C1/C6"},"type":{"span":null,"text":"1s"}},"interruptionResistance":"75","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":null}}