ion":{"0":{"id":0,"talentId":101,"name":"豐穰的春雷","description":"施放<color=#FFD780FF>雷影劍</color>能產生的豐穰勾玉數量提升至3枚。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerElectric_01"},"1":{"id":1,"talentId":102,"name":"震怒的蒼雷","description":"<color=#FFD780FF>雷轟電轉</color>的威光落雷命中敵人後，會使敵人的<color=#FFACFFFF>雷元素抗性</color>降低15%，持續8秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerElectric_02"},"2":{"id":2,"talentId":103,"name":"連延的遠雷","description":"<color=#FFD780FF>雷轟電轉</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_PlayerElectric_01"},"3":{"id":3,"talentId":104,"name":"難測的雲雷","description":"角色獲得<color=#FFD780FF>雷影劍</color>產生的豐穰勾玉時，若該角色現有的元素能量低於35%，豐穰勾玉恢復的元素能量提高100%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerElectric_03"},"4":{"id":4,"talentId":105,"name":"荒野的霆雷","description":"<color=#FFD780FF>雷影劍</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_PlayerElectric_02"},"5":{"id":5,"talentId":106,"name":"撼世的神雷","description":"<color=#FFD780FF>雷轟電轉</color>每引發2次威光落雷，則大幅增強下一次威光落雷，造成原本200%的傷害，並為目前角色額外恢復1點元素能量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerElectric_04"}},"dictionary":{"talent":["N10050001"],"constellation":[],"effectsInfo":{"N10050001":{"id":10050001,"name":"額外強化效果","description":"每與一種元素進行過共鳴，旅行者便會獲得對應的屬性提升：\\n<color=#80FFD7FF>風元素</color>：暴擊率提升10%。\\n<color=#FFE699FF>岩元素</color>：防禦力提升20%。\\n<color=#FFACFFFF>雷元素</color>：元素充能效率提升20%。\\n<color=#99FF88FF>草元素</color>：元素精通提升60點。\\n<color=#80C0FFFF>水元素</color>：生命值提升20%。\\n<color=#FF9999FF>火元素</color>：攻擊力提升20%。\\n<color=#99FFFFFF>冰元素</color>：暴擊傷害提升20%。","params":null,"props":["","","","",""]}}}}}