stance":"30.189","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Normal Attack 4-Hit","elementalGaugeTheory":"1U","internalCooldown":"rowspan","interruptionResistance":"71.871","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"655","verticalForce":"800"},"bluntAttack":false},{"name":"Charged Attack","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Charged Attack"},"type":{"span":null,"text":"0.5s"}},"interruptionResistance":"120","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"480","verticalForce":"600"},"bluntAttack":false},{"name":"Plunging Attack Collision","elementalGaugeTheory":"0U","internalCooldown":null,"interruptionResistance":"25","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Low Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"100","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"800","verticalForce":"0"},"bluntAttack":true},{"name":"High Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"150","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"0","verticalForce":"800"},"bluntAttack":true}]},"1":{"skillId":10902,"type":0,"name":"近迫式急促攔射","description":"夏沃蕾將銃槍快速抵肩，射擊敵人，造成<color=#FF9999FF>火元素範圍傷害</color>。\\n夏沃蕾進行射擊後的一段時間內，將持續為目前場上自己的角色恢復生命值，回復量受益於夏沃蕾的生命值上限。\\n長按時將以不同的方式施放。\\n\\n<color=#FFD780FF>長按</color>\\n進入瞄準狀態，鎖定準星內的一名敵人，進行更為精確的攔截射擊；若夏沃蕾擁有「超量裝藥彈頭」，則轉為發射「超量裝藥彈頭」，造成範圍更大、傷害更高的<color=#FF9999FF>火元素傷害</color>。\\n夏沃蕾將在隊伍中附近的角色觸發超載反應時獲得1枚「超量裝藥彈頭」。至多同時持有1枚「超量裝藥彈頭」。\\n\\n<color=#FFD780FF>始基力：荒性</color>\\n每隔一段時間，夏沃蕾的「近迫式急促攔射」命中時，將喚出流湧之刃，造成具有荒性的<color=#FF9999FF>火元素傷害</color>。\\n\\n<i>「其實訓練條例裡只有『攔射』這個專有名詞，但有本小說的主角認為包含專業詞彙的招式名稱能讓自己人更有幹勁、讓敵人輸在氣勢的起跑線上…我覺得很有道理，就改了一下條例！」</i>","descriptionBuff":null,"icon":"Skill_S_Ch