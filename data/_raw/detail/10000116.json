{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"2":{"id":2,"talentId":1163,"name":"高階情感韌體","description":"元素戰技<color=#FFD780FF>{LINK#S11162}滌淨模式·穩態載頻{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Ineffa_01"},"3":{"id":3,"talentId":1164,"name":"敕諭未至之路","description":"隊伍中自己的角色觸發月感電反應時，將恢復5點元素能量，該效果每4秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ineffa_03"},"4":{"id":4,"talentId":1165,"name":"超越鏡影之夢","description":"元素爆發<color=#FFD780FF>{LINK#S11165}至高律令·全域掃滅{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Ineffa_02"},"5":{"id":5,"talentId":1166,"name":"獻予你的明晨","description":"伊涅芙處於「載流複合」效果影響下時，附近的雷暴雲對敵人進行雷擊後，伊涅芙將對目前場上自己的角色周圍的敵人造成相當於伊涅芙攻擊力135%的<color=#FFACFFFF>雷元素範圍傷害</color>，該傷害視為月感電反應造成的傷害，上述效果每3.5秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Ineffa_04","advancedProps":[{"name":"Extra Lunar-Charged","elementalGaugeTheory":"0U","internalCooldown":null,"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":{"talent":["N11160001"],"constellation":[],"effectsInfo":{"N11160001":{"id":11160001,"name":"薇爾琪塔","description":"與伊涅芙一同戰鬥的好幫手，可以透過施放元素戰技或元素爆發召喚至場上。\\n若周圍存在敵人，每隔2秒，薇爾琪塔將快速移動至一名敵人附近，對其進行放電攻擊，造成<color=#FFACFFFF>雷元素範圍傷害</color>。\\n同時至多存在一個伊涅芙自己創造的薇爾琪塔。\\n\\n此外，在挪德卡萊，似乎可以通過某種途徑來改變薇爾琪塔的外觀…","params":null,"props":["","","","",""]}}}}}