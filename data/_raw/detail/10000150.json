":["N11500001","N11500003"],"linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":0,"type":"normal"},{"id":1,"type":"normal"},{"id":5,"type":"normal"}]}},"5":{"skillId":15022,"type":2,"name":"赤忱者的悲歌","description":"基於奧黛塔攻擊力超過1000點的部分，每100點攻擊力都將使奧黛塔造成的星爍反應傷害額外造成原本1.5%的傷害，至多依此方式額外造成原本30%的傷害。","descriptionBuff":"","icon":"UI_Talent_S_Odette_06","linkedConstellations":null},"6":{"skillId":15023,"type":2,"name":"星耀祝禮·銀曉之舞","description":"處於{LINK#N11330003}<color=#FFD780FF>極星輝域</color>{/LINK}中時/隊伍中的角色在附近觸發星擴散反應後的8秒內，奧黛塔將分別進入<color=#FFD780FF>輝映·星超導</color>/<color=#FFD780FF>輝映·星擴散</color>狀態。\\n隊伍中的角色觸發超導/冰元素擴散反應時，將轉為觸發星超導/星擴散反應，且基於奧黛塔的攻擊力，提升隊伍中角色造成的上述反應的基礎傷害：每100點攻擊力都將提升0.7%上述反應的基礎傷害，至多依此方式提升14%傷害。","descriptionBuff":"","icon":"UI_Talent_S_Odette_07","effects":["N11330003"],"linkedConstellations":null},"8":{"skillId":15025,"type":2,"name":"迴響中的冬夢","description":"在小地圖上顯示周圍的<color=#FFD780FF>至冬區域特產</color>的位置。\\n在閒暇時練習舞蹈，或許還會觸發其他的效果…","descriptionBuff":"","icon":"UI_Talent_S_Odette_08","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":1501,"name":"「不曾起舞的清晨，她望向倒影」","description":"施放特殊元素戰技{LINK#N11500002}<color=#FFD780FF>柔板·破曉終奏</color>{/LINK}後，在共舞結束時，奧黛塔將對附近的敵人造成一次額外的<color=#99FFFFFF>冰元素範圍傷害</color>，該傷害視為：\\n·<color=#FFD780FF>輝映·星超導</color>或不處於輝映狀態：相當於奧黛塔攻擊力300%的星超導反應傷害。\\n·<color=#FFD780FF>輝映·星擴散</color>：相當於奧黛塔攻擊力450%的星擴散反應傷害。\\n\\n此外，突破天賦「獲選者的春祭」獲得強化：召喚{LINK#N11500001}<color=#FFD780FF>獨舞倒影</color>{/LINK}時，奧黛塔將額外獲得2層{LINK#N11500003}<color=#FFD780FF>華彩</color>{/LINK}，且奧黛塔處於隊伍後臺時，清除<color=#FFD780FF>華彩</color>的速度提升至每秒2層。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_01","effects":["N11500002","N11500001","N11500003"]},"1":{"id":1,"talentId":1502,"name":"「她想，我要見證雪鵠未見之夢」","description":"突破天賦「獲選者的春祭」獲得強化：每層{LINK#N11500003}<color=#FFD780FF>華彩</color>{/LINK}還會使角色的攻擊力提升7%。\\n此外，{LINK#N11500001}<color=#FFD780FF>獨舞倒影</color>{/LINK}在場時，若奧黛塔處於{LINK#N11500004}<color=#FFD780FF>輝映·星爍</color>{/LINK}狀態，<color=#FFD780FF>獨舞倒影</color>附近敵人的對應元素抗性還會降低20%：\\n·<color=#FFD780FF>輝映·星超導</color>：<color=#99FFFFFF>冰元素</color>、<color=#FFACFFFF>雷元素</color>。\\n·<color=#FFD780FF>輝映·星擴散</color>：<color=#99FFFFFF>冰元素</color>、<color=#80FFD7FF>風元素</color>。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_02","effects":["N11500003","N11500004","N11500001"]},"2":{"id":2,"talentId":1503,"name":"「我要追逐呼嘯的風，向上獨行」","description":"元素戰技<color=#FFD780FF>{LINK#S11502}柔板·幻靈夜舞{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Odette_01"},"3":{"id":3,"talentId":1504,"name":"「向上，墜往恍惚、燃燒的藍空」","description":"元素爆發<color=#FFD780FF>疾板·蒼羽一夢</color>獲得強化：奧黛塔獲得<color=#FFD780FF>雪鵠之夢</color>時，還會使隊伍中附近的其他角色造成的星爍反應傷害提升，提升值相當於<color=#FFD780FF>雪鵠之夢</color>效果的50%。\\n\\n此外，隊伍中的角色對敵人造成星爍反應傷害時，奧黛塔還會對敵人進行一次協同攻擊，造成一次<color=#99FFFFFF>冰元素範圍傷害</color>，每3.5秒至多觸發一次，該傷害視為：\\n·<color=#FFD780FF>輝映·星超導</color>或不處於輝映狀態：相當於奧黛塔攻擊力66%的星超導反應傷害。\\n·<color=#FFD780FF>輝映·星擴散</color>：相當於奧黛塔攻擊力99%的星擴散反應傷害。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_03"},"4":{"id":4,"talentId":1505,"name":"「看呀，我已告別塵與土的苦痛」","description":"元素爆發<color=#FFD780FF>{LINK#S11505}疾板·蒼羽一夢{/LINK}</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Odette_02"},"5":{"id":5,"talentId":1506,"name":"「伸出手，觸及蒼穹永恆的面容」","description":"突破天賦「獲選者的春祭」獲得強化：奧黛塔賦予隊伍中附近的所有角色{LINK#N11500003}<color=#FFD780FF>華彩</color>{/LINK}時，自己的華彩不再會減少。\\n此外，處於<color=#FFD780FF>華彩</color>影響下的角色，對敵人造成的星爍反應傷害{LINK#N11190007}<color=#FFD780FF>擢升</color>{/LINK}25%，且奧黛塔對敵人造成的星爍反應傷害額外擢升20%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_04","effects":["N11500003","N11190007"]}},"dictionary":{"talent":["N11500001","N11500002","N11500003","N11330003"],"constellation":["N11500002","N11500001","N11500003","N11500004","N11190007"],"effectsInfo":{"N11500001":{"id":11500001,"name":"獨舞倒影","description":"與奧黛塔一同起舞的心像倒影，可以透過施放元素戰技或元素爆發召喚至場上。\\n會交替呈現<color=#FFD780FF>拂羽</color>與<color=#FFD780FF>旋翼</color>兩種舞步，以優雅輕盈的舞姿間歇性攻擊附近的敵人，造成<color=#99FFFFFF>冰元素範圍傷害</color>。\\n同時至多存在一個奧黛塔自己創造的<color=#FFD780FF>獨舞倒影</color>。\\n\\n此外，附近存在奧黛塔自己召喚的<color=#FFD780FF>獨舞倒影</color>時，奧黛塔的元素戰技<color=#FFD780FF>柔板·幻靈夜舞</color>將會被替換為特殊的元素戰技<color=#FFD780FF>柔板·破曉終奏</color>。","params":null,"props":["","","","",""]},"N11500002":{"id":11500002,"name":"柔板·破曉終奏","description":"奧黛塔的特殊元素戰技，對附近的敵人持續造成<color=#99FFFFFF>冰元素範圍傷害</color>，並在共舞結束時，造成一次視為星超導反應傷害的<color=#99FFFFFF>冰元素範圍傷害</color>。共舞時，奧黛塔可以控制舞步的方向。\\n<color=#FFD780FF>輝映·星爍</color>：共舞結束時，改為造成一次視為對應星爍反應傷害的<color=#99FFFFFF>冰元素範圍傷害</color>。\\n\\n此外，施放特殊元素戰技<color=#FFD780FF>柔板·破曉終奏</color>後，在<color=#FFD780FF>獨舞倒影</color>剩餘持續時間內，若奧黛塔處於<color=#FFD780FF>輝映·星爍</color>狀態，則<color=#FFD780FF>獨舞倒影</color>的兩種舞步還會額外造成視為對應星爍反應傷害的<color=#99FFFFFF>冰元素範圍傷害</color>。","params":null,"props":["","","","",""]},"N11500003":{"id":11500003,"name":"華彩","description":"解鎖突破天賦「獲選者的春祭」後，奧黛塔召喚<color=#FFD780FF>獨舞倒影</color>時將會獲得的特殊效果。\\n每層<color=#FFD780FF>華彩</color>都會使角色造成的星爍反應傷害提升15%，持續至<color=#FFD780FF>獨舞倒影</color>退場或重新召喚<color=#FFD780FF>獨舞倒影</color>。\\n當奧黛塔處於隊伍後臺時，奧黛塔每秒會清除1層<color=#FFD780FF>華彩</color>，並使隊伍中附近的其他角色獲得對應層數的<color=#FFD780FF>華彩</color>。","params":null,"props":["0.15","1","","",""]},"N11330003":{"id":11330003,"name":"極星輝域","description":"觸發星超導反應時，附近的區域會短暫變化為<color=#FFD780FF>極星輝域</color>。處於極星輝域中時，特定角色將會進入<color=#FFD780FF>輝映·星超導</color>狀態，使其不同技能分別獲得對應的強化效果。","params":null,"props":["","","","",""]},"N11500004":{"id":11500004,"name":"輝映·星爍","description":"<color=#FFD780FF>輝映·星超導</color>與<color=#FFD780FF>輝映·星擴散</color>統稱為<color=#FFD780FF>輝映·星爍</color>狀態。\\n角色同時只能受到一種輝映狀態影響，且優先被<color=#FFD780FF>輝映·星超導</color>影響。","params":null,"props":["","","","",""]},"N11190007":{"id":11190007,"name":"擢升","description":"特殊的傷害提升效果，與其他的傷害提升效果分別獨立計算。","params":null,"props":["","","","",""]}}}}}