s":null}},"constellation":{"0":{"id":0,"talentId":671,"name":"巡護深林","description":"柯萊處於隊伍後臺時，元素充能效率提升20%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Collei_01"},"1":{"id":1,"talentId":672,"name":"漫行山藪","description":"突破天賦「飛葉迴斜」轉變為：\\n<color=#FFD780FF>飛葉輪</color>返回時，將為角色賦予突破天賦「飛葉迴斜」的「新葉」狀態，持續對身邊的敵人造成相當於柯萊攻擊力40%的<color=#99FF88FF>草元素傷害</color>，持續3秒。\\n從施放<color=#FFD780FF>拂花偈葉</color>開始，到此次新葉狀態消失前，如果隊伍中自己的角色觸發了燃燒、原激化、超激化、蔓激化、綻放、超綻放、烈綻放或月綻放反應，則使此次新葉效果的持續時間延長3秒。\\n新葉效果至多依此方式延長一次持續時間。在持續期間再次產生新葉效果時，將移除原有的效果。新葉效果造成的傷害視為元素戰技傷害。\\n需要解鎖突破天賦「飛葉迴斜」。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Collei_02"},"2":{"id":2,"talentId":673,"name":"夏堇芳菲","description":"<color=#FFD780FF>拂花偈葉</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Collei_02"},"3":{"id":3,"talentId":674,"name":"騫林饋遺","description":"施放<color=#FFD780FF>貓貓秘寶</color>時，將使隊伍中附近的所有角色（不包括柯萊自己）的元素精通提升60點，持續12秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Collei_03"},"4":{"id":4,"talentId":675,"name":"俱象殘火","description":"<color=#FFD780FF>貓貓秘寶</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Collei_01"},"5":{"id":5,"talentId":676,"name":"墜鏃為林","description":"<color=#FFD780FF>飛葉輪</color>命中時，會產生一個迷你柯里安巴，造成相當於柯萊攻擊力200%的<color=#99FF88FF>草元素傷害</color>。\\n每次施放<color=#FFD780FF>拂花偈葉</color>至多產生1次迷你柯里安巴。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Collei_04","advancedProps":[{"name":"Miniature Cuilein-Anbar","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"30","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":null}}