icalForce":"0"},"bluntAttack":true}]},"4":{"skillId":921,"type":2,"name":"破碎的絕岩","description":"<color=#FFD780FF>星隕劍</color>的冷卻時間減少2秒。","descriptionBuff":"","icon":"UI_Talent_S_PlayerRock_05","linkedConstellations":null},"5":{"skillId":922,"type":2,"name":"狂亂的崩岩","description":"普通攻擊的最後一擊會附帶崩毀，對範圍內的敵人造成60%攻擊力的<color=#FFE699FF>岩元素傷害</color>。","descriptionBuff":"","icon":"UI_Talent_S_PlayerRock_06","linkedConstellations":null,"advancedProps":[{"name":"Collapse","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"13.5","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":true}]},"9":{"skillId":951,"type":2,"name":"異邦的堅岩","description":"從過往的旅途中，汲取全新的力量。每與一種元素進行過共鳴，便會獲得額外的{LINK#N10050001}<color=#FFD780FF>強化效果</color>{/LINK}。\\n\\n此外，隊伍中附近的角色進入護盾庇護下時、護盾因任何原因被替換時，或生成<color=#FFE699FF>岩元素創造物</color>時，旅行者將獲得1層「古岩之刃」，至多疊加3層，每1秒至多依此方式使旅行者獲得1層「古岩之刃」。擁有3層「古岩之刃」時進行重擊，會消耗所有的「古岩之刃」，轉為進行特殊的<color=#FFD780FF>重擊·岩墜</color>。\\n\\n<color=#FFD780FF>重擊·岩墜</color>\\n·每段重擊將造成傷害更高的<color=#FFE699FF>岩元素傷害</color>，傷害提升相當於旅行者攻擊力的120%。\\n·命中敵人後的15秒內，隊伍中附近的角色護盾強效提升20%。\\n·每15秒至多進行一次<color=#FFD780FF>重擊·岩墜</color>。","descriptionBuff":"","icon":"UI_Talent_S_PlayerRock_07","effects":["N10050001"],"linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":91,"name":"巍然的青岩","description":"隊伍中角色處於<color=#FFD780FF>岩潮疊嶂</color>的岩嶂包圍中時，暴擊率提升10%，並提高抗打斷能力。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerRock_01"},"1":{"id":1,"talentId":92,"name":"不穩的熔岩","description":"<color=#FFD780FF>星隕劍</color>的荒星被摧毀時會再度發生爆炸，造成等同於星隕劍傷害的額外<color=#FFE699FF>岩元素範圍傷害</color>。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_PlayerRock_02"},"2":{"id":2,"talentId":93,"name":"八方之岩","description":"<color=#FFD780FF>岩潮疊嶂</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_PlayerRock_02"},"3":{"