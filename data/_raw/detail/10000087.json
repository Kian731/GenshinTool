:false}]},"4":{"skillId":8721,"type":2,"name":"古海孑遺的權柄","description":"隊伍中的角色對敵人觸發蒸發、凍結、感電、月感電、綻放、月綻放、水元素擴散、水元素結晶或月結晶反應時，將為那維萊特產生持續30秒，至多疊加3層的「遺龍之榮」效果，使重擊·衡平推裁造成原本110%/125%/160%的傷害。\\n每種元素反應產生的「遺龍之榮」分別獨立存在。","descriptionBuff":"","icon":"UI_Talent_S_Neuvillette_05","linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":0,"type":"normal"},{"id":1,"type":"normal"}]}},"5":{"skillId":8722,"type":2,"name":"至高仲裁的紀律","description":"基於目前生命值超出生命值上限30%的部分，每1%使那維萊特獲得0.6%<color=#80C0FFFF>水元素傷害加成</color>，依此方式，至多提升30%。","descriptionBuff":"","icon":"UI_Talent_S_Neuvillette_06","linkedConstellations":null},"6":{"skillId":8723,"type":2,"name":"匯聚如浪潮一般","description":"隊伍中自己的角色進行水下衝刺時，移動速度提升15%。\\n無法與效果完全相同的固有天賦疊加。","descriptionBuff":"","icon":"UI_Talent_S_Neuvillette_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":871,"name":"尊榮的創定","description":"那維萊特登場時，獲得一層突破天賦「古海孑遺的權柄」的「遺龍之榮」。需要解鎖突破天賦「古海孑遺的權柄」。\\n此外，進行重擊蓄力·訴論心證與重擊·衡平推裁時，提高那維萊特的抗打斷能力。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Neuvillette_01"},"1":{"id":1,"talentId":872,"name":"律法的命誡","description":"突破天賦「古海孑遺的權柄」獲得強化：每存在一層「遺龍之榮」，就使重擊·衡平推裁的暴擊傷害提升14%，至多依此方式提升42%。\\n需要解鎖突破天賦「古海孑遺的權柄」。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Neuvillette_02"},"2":{"id":2,"talentId":873,"name":"溯古的擬制","description":"<color=#FFD780FF>普通攻擊·如水從平</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":1,"extraLevel":3}},"icon":"UI_Talent_U_Neuvillette_01"},"3":{"id":3,"talentId":874,"name":"悲憫的冠冕","description":"那維萊特處於目前場上並受到治療時，將產生1枚源水之滴。此效果每4秒至多觸發一次。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Neuvillette_03"},"4":{"id":4,"talentId":875,"name":"公理的決裁","description":"<color=#FFD780FF>潮水啊！我已歸來</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Neuvillette_02"},"5":{"id":5,"talentId":876,"name":"忿怒的報償","description":"施放重擊·衡平推裁時，那維萊特可以吸收附近一定範圍內的源水之滴，每吸收一枚源水之滴，都將使重擊·衡平推裁的持續時間延長1秒。\\n此外，重擊·衡平推裁命中敵人時，每2秒，將額外釋放兩道洪流，每道洪流造成相當於那維萊特生命值上限10%的<color=#80C0FFFF>水元素傷害</color>。依此方式造成的傷害視為重擊·衡平推裁造成的傷害。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Neuvillette_04","advancedProps":[{"name":"Currents","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"C6"},"type":{"span":null,"text":"2.5s/3 Hits"}},"interruptionResistance":"25","interruptionResistanceStagger":{"staggerLevel":"Shake","horizontalForce":"0","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":null}}