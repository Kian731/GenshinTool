},"advancedProps":[{"name":"Skill DMG","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Heavy","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false},{"name":"Adeptal Legacy White Jade Radish DMG","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Elemental Burst"},"type":{"span":null,"text":"1.5s"}},"interruptionResistance":"15","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":7721,"type":2,"name":"天星漫散","description":"處於<color=#FFD780FF>玉顆珊珊月中落</color>的桂子仙機狀態下時，當瑤瑤進行衝刺、跳躍或處於奔跑狀態下時，將不斷向附近的敵人投擲白玉蘿蔔。每0.6秒至多依此方式投擲1枚白玉蘿蔔。","descriptionBuff":"","icon":"UI_Talent_S_Yaoyao_05","linkedConstellations":null},"5":{"skillId":7722,"type":2,"name":"推己及人","description":"<color=#FFD780FF>白玉蘿蔔</color>炸裂時，處在其影響範圍內的目前場上角色將每1秒恢復一次生命值，回復量基於瑤瑤生命值上限的0.8%，持續5秒。","descriptionBuff":"","icon":"UI_Talent_S_Yaoyao_06","linkedConstellations":null},"6":{"skillId":7723,"type":2,"name":"踮腳·躡影輕蹤","description":"瑤瑤在隊伍中時，隊伍中自己的角色接近晶蝶等部分生物時，不會驚動牠們。\\n有效對象可參考圖鑑中「生物誌／野生動物」的「其他」分類。","descriptionBuff":"","icon":"UI_Talent_S_Yaoyao_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":771,"name":"妙受瓊閣","description":"<color=#FFD780FF>白玉蘿蔔</color>炸裂時，處在其影響範圍內的目前場上角色獲得15%<color=#99FF88FF>草元素傷害加成</color>，持續8秒，並恢復15點體力。每5秒只能依此方式恢復1次體力。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Yaoyao_01"},"1":{"id":1,"talentId":772,"name":"正思無邪","description":"處於<color=#FFD780FF>玉顆珊珊月中落</color>的桂子仙機狀態下時，若白玉蘿蔔的炸裂傷害命中敵人，瑤瑤將恢復3點元素能量。每0.8秒至多依此方式恢復一次元素能量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Yaoyao_02"},"2":{"id":2,"talentId":773,"name":"墩墩善道","description":"<color=#FFD780FF>雲臺團團降蘆菔</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Yaoyao_01"},"3":{"id":3,"talentId":774,"name":"爰爰可親","description":"施放<color=#FFD780FF>雲臺團團降蘆菔</color>或<color=#FFD780FF>玉顆珊珊月中落</color>後，基於瑤瑤生命值上限的0.3%，提升瑤瑤的元素精通，持續8秒。依此方式，至多提升120點元素精通。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Yaoyao_03"},"4":{"id":4,"talentId":775,"name":"惻隱本義","description":"<color=#FFD780FF>玉顆珊珊月中落</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Yaoyao_02"},"5":{"id":5,"talentId":776,"name":"慈惠仁心","description":"<color=#FFD780FF>月桂·拋擲型</color>每投擲2次白玉蘿蔔，就會在下次投擲時額外投擲1枚超厲害·大蘿蔔。相比白玉蘿蔔，超厲害·大蘿蔔炸裂時的影響範圍更大，炸裂時產生如下效果：\\n·基於瑤瑤攻擊力的75%，造成<color=#99FF88FF>草元素範圍傷害</color>；\\n·基於瑤瑤生命值上限的7.5%，為其中的目前場上角色恢復生命值。\\n\\n每個月桂·拋擲型至多投擲2次超厲害·大蘿蔔。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Yaoyao_04","advancedProps":[{"name":"Mega Radish DMG","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"30","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":null}}