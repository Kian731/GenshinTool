igh Plunge","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"200","interruptionResistanceStagger":{"staggerLevel":"Air","horizontalForce":"0","verticalForce":"800"},"bluntAttack":true}]},"1":{"skillId":11282,"type":0,"name":"烈風終墜","description":"以絕對的力量，呈現西風劍術的真髓，依據點按、長按，以不同的方式產生效果。\\n\\n<color=#FFD780FF>點按</color>\\n向前方騰躍而起並順勢劈斬，造成<color=#80FFD7FF>風元素範圍傷害</color>，並切換至{LINK#N11280001}<color=#FFD780FF>狂飆突進</color>{/LINK}模式。\\n處於<color=#FFD780FF>狂飆突進</color>模式下時，法爾伽的普通攻擊與重擊造成的傷害提高，無法進行下落攻擊，且進行普通攻擊與重擊時，將根據隊伍中角色的元素類型，使雙持的大劍分別造成無法被附魔覆蓋的對應元素傷害。\\n此外，處於<color=#FFD780FF>狂飆突進</color>模式下時，若隊伍中存在<color=#FF9999FF>火元素</color>、<color=#80C0FFFF>水元素</color>、<color=#FFACFFFF>雷元素</color>或<color=#99FFFFFF>冰元素</color>角色，法爾伽的元素戰技<color=#FFD780FF>烈風終墜</color>將會被替換為特殊的元素戰技{LINK#N11280002}<color=#FFD780FF>四風將起</color>{/LINK}，造成對應元素傷害與<color=#80FFD7FF>風元素傷害</color>。此外，法爾伽還可以消耗特殊元素戰技<color=#FFD780FF>四風將起</color>的可使用次數，進行不消耗體力的特殊重擊<color=#FFD780FF>蒼噬</color>，造成對應元素傷害與<color=#80FFD7FF>風元素傷害</color>。\\n\\n<color=#FFD780FF>長按</color>\\n進行蓄力後，向前方騰躍而起，蓄力時間會提升騰躍距離。","descriptionBuff":null,"icon":"Skill_S_Varka_01","promote":{"1":{"level":1,"costItems":null,"coinCost":null,"description":["技能傷害|{param1:F1P}","點按冷卻時間|{param19:F1}秒","長按冷卻時間|{param20:F1}秒","狂飆突進·持續時間|{param2:F1}秒","狂飆突進·一段傷害|{param3:F1P}","狂飆突進·二段傷害|{param5:F1P}+{param4:F1P}","狂飆突進·三段傷害|{param7:F1P}+{param6:F1P}","狂飆突進·四段傷害|{param8:F1P}+{param9:F1P}","狂飆突進·五段傷害|{param10:F1P}+{param11:F1P}","狂飆突進·重擊傷害|{param12:F1P}+{param13:F1P}","四風將起傷害|{param14:F1P}+{param15:F1P}","蒼噬傷害|{param16:F1P}*2+{param17:F1P}*2","四風將起冷卻時間|{param18:F1}秒","","","","","","",""],"params":[2.784,12,0.818247,0.556876,0.299856,0.752987,0.405455,0.692894,0.373097,0.871872,0.46947,1.070485,0.576415,1.7576,0.9464,0.936,0.504,11,16,8]},"2":{"level":2,"costItems":{"104301":3,"112122":6},"coinCost":12500,"description":["技能傷害|{param1:F1P}","點按冷卻時間|{param19:F1}秒","長按冷卻時間|{param20:F1}秒","狂飆突進·持續時間|{param2:F1}秒","狂飆突進·一段傷害|{param3:F1P}","狂飆突進·二段傷害|{pa