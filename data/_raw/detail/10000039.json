ts"}},"interruptionResistance":"50","interruptionResistanceStagger":{"staggerLevel":"Shake","horizontalForce":"0","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":3921,"type":2,"name":"貓尾隱藏菜單","description":"處於<color=#FFD780FF>貓爪凍凍</color>的護盾保護下的角色，移動速度提升10%，體力消耗降低10%。","descriptionBuff":"","icon":"UI_Talent_S_Diona_05","linkedConstellations":null},"5":{"skillId":3922,"type":2,"name":"滑稽百出的醉相","description":"敵人進入<color=#FFD780FF>最烈特調</color>的領域後的15秒內，攻擊力降低10%。","descriptionBuff":"","icon":"UI_Talent_S_Diona_06","linkedConstellations":null},"6":{"skillId":3923,"type":2,"name":"附贈的下酒菜","description":"完美烹飪恢復類食物時，有12%的機率獲得兩倍產出。","descriptionBuff":"","icon":"UI_Talent_Cook_Heal","linkedConstellations":null},"9":{"skillId":3951,"type":2,"name":"珍選秘藏","description":"施放元素戰技<color=#FFD780FF>貓爪凍凍</color>後的20秒內，隊伍中的角色觸發星超導、超導、冰元素擴散、星擴散反應時，迪奧娜還會協同發射3枚<color=#FFD780FF>凍凍貓貓爪</color>。依此方式發射的<color=#FFD780FF>凍凍貓貓爪</color>無法產生元素微粒，在命中敵人時也無法產生護盾。該效果每3.5秒至多觸發一次。\\n此外，處於{LINK#N11330003}<color=#FFD780FF>極星輝域</color>{/LINK}中時/隊伍中的角色在附近觸發星擴散反應後的8秒內，迪奧娜將分別進入<color=#FFD780FF>輝映·星超導</color>/<color=#FFD780FF>輝映·星擴散</color>狀態。","descriptionBuff":"","icon":"UI_Talent_S_Diona_08","effects":["N11330003"],"linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":391,"name":"特調的餘韻","description":"<color=#FFD780FF>最烈特調</color>的效果結束時，為迪奧娜恢復15點元素能量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Diona_01"},"1":{"id":1,"talentId":392,"name":"貓爪冰搖","description":"<color=#FFD780FF>貓爪凍凍</color>造成的傷害提高15%，護盾的傷害吸收量提高15%。\\n此外，命中時，將為附近的目前其他場上角色製造一個傷害吸收量為<color=#FFD780FF>貓爪凍凍</color>50%的護盾，持續5秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Diona_02"},"2":{"id":2,"talentId":393,"name":"還、還要續杯？","description":"<color=#FFD780FF>最烈特調</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Diona_01"},"3":{"id":3,"talentId":394,"name":"「酒業殺手」","description":"在<color=#FFD780FF>最烈特調</color>的領域內，迪奧娜的瞄準射擊的所需的蓄力時間減少60%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Diona_03"},"4":{"id":4,"talentId":395,"name":"雙份加冰","description":"<color=#FFD780FF>貓爪凍凍</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Diona_02"},"5":{"id":5,"talentId":396,"name":"貓尾打烊之時","description":"處在<color=#FFD780FF>最烈特調</color>領域內的角色，依據生命值獲得如下效果：\\n·生命值低於或等於50%時，受治療加成提升30%。\\n·生命值高於50%時，元素精通提升200。","descriptionBuff":"處在<color=#FFD780FF>最烈特調</color>領域內的角色，依據生命值獲得如下效果：\\n·生命值低於或等於50%時，受治療加成提升30%。\\n·生命值高於50%時，元素精通提升200。\\n\\n此外，迪奧娜的生命值上限提升25%。\\n<color=#FFD780FF>輝映·星爍</color>：處於最烈特調領域內的角色造成的對應反應的傷害提高：\\n<color=#FFD780FF>輝映·星超導</color>：超導、星超導反應傷害提升40%。\\n<color=#FFD780FF>輝映·星擴散</color>：冰元素擴散、星擴散反應傷害提升40%。","extraData":null,"icon":"UI_Talent_S_Diona_04"}},"dictionary":{"talent":["N11330003"],"constellation":[],"effectsInfo":{"N11330003":{"id":11330003,"name":"極星輝域","description":"觸發星超導反應時，附近的區域會短暫變化為<color=#FFD780FF>極星輝域</color>。處於極星輝域中時，特定角色將會進入<color=#FFD780FF>輝映·星超導</color>狀態，使其不同技能分別獲得對應的強化效果。","params":null,"props":["","","","",""]}}},"buff":true}}