_112002"},"112003":{"name":"史萊姆清","rank":2,"icon":"UI_ItemIcon_112003"},"112004":{"name":"史萊姆原漿","rank":3,"icon":"UI_ItemIcon_112004"},"113001":{"name":"颶風之種","rank":4,"icon":"UI_ItemIcon_113001"},"113006":{"name":"北風之尾","rank":5,"icon":"UI_ItemIcon_113006"}},"talent":{"0":{"skillId":10221,"type":0,"name":"神代射術","description":"<color=#FFD780FF>普通攻擊</color>\\n進行至多六段的連續弓箭射擊。\\n\\n<color=#FFD780FF>重擊</color>\\n進行傷害更高、更為精準的<color=#FFD780FF>瞄準射擊</color>。\\n瞄準時，眷顧天地的風會在箭矢上持續匯聚。聚滿了風之力的箭矢會造成<color=#80FFD7FF>風元素傷害</color>。\\n\\n<color=#FFD780FF>下落攻擊</color>\\n從空中射出箭雨，並迅速下墜衝擊地面，在落地時造成範圍傷害。","descriptionBuff":"<color=#FFD780FF>普通攻擊</color>\\n進行至多六段的連續弓箭射擊。\\n\\n<color=#FFD780FF>重擊</color>\\n進行傷害更高、更為精準的<color=#FFD780FF>瞄準射擊</color>。\\n瞄準時，眷顧天地的風會在箭矢上持續積聚。聚滿了風之力的箭矢會造成<color=#80FFD7FF>風元素傷害</color>。\\n\\n<color=#FFD780FF>下落攻擊</color>\\n從空中射出箭雨，並迅速下墜衝擊地面，在落地時造成範圍傷害。\\n\\n<color=#FFD780FF>魔導·秘儀</color>\\n元素爆發<color=#FFD780FF>風神之詩</color>創造的暴風之眼存在期間，溫迪將獲得額外的強化效果：\\n·溫迪的普通攻擊將轉為發射能穿透敵人的<color=#FFD780FF>颶風箭</color>，對路徑上的敵人造成更高的<color=#80FFD7FF>風元素傷害</color>。\\n·溫迪的普通攻擊命中敵人時，將使暴風之眼的持續時間延長1秒，冷卻時間延長0.5秒。該效果每0.1秒至多觸發一次，每次施放元素爆發<color=#FFD780FF>風神之詩</color>後至多觸發2次。","icon":"Skill_A_02","promote":{"1":{"level":1,"costItems":null,"coinCost":null,"description":["一段傷害|{param1:F1P}+{param1:F1P}","二段傷害|{param2:F1P}","三段傷害|{param3:F1P}","四段傷害|{param4:F1P}+{param4:F1P}","五段傷害|{param5:F1P}","六段傷害|{param6:F1P}","瞄準射擊|{param7:F1P}","滿蓄力瞄準射擊|{param8:P}","下墜期間傷害|{param9:F1P}","低空/高空墜地衝擊傷害|{param10:P}/{param11:P}","颶風箭傷害|{param12:F1P}普通攻擊傷害","","","","","","","","",""],"params":[0.20382,0.44376,0.52374,0.26058,0.50654,0.7095,0.4386,1.24,0.568288,1.136335,1.419344,1.6,0,0,0,0,0,0,0,0]},"2":{"level":2,"costItems":{"104307":3,"112002":6},"coinCost":12500,"description":["一段傷害|{param1:F1P}+{param1:F1P}","二段傷害|{param2:F1P}","三段傷害|{param3:F1P}","四段傷害|{param4:F1P}+{param4:F1P}","五段傷害|{param5:F1P}","六段傷害|{param6:F1P}","瞄準射擊|{param7:F1P}","滿蓄力瞄準射擊|{param8:P}","下墜期間傷害|{param9:F1P}","低空/高空墜地衝擊傷害|{param10:P}/{param1