al"}]},"advancedProps":[{"name":"Skill DMG","elementalGaugeTheory":"1U","internalCooldown":{"tag":{"span":null,"text":"Elemental Burst"},"type":{"span":null,"text":"1.9s"}},"interruptionResistance":"100","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]},"4":{"skillId":9521,"type":2,"name":"應有適當的休憩","description":"施放<color=#FFD780FF>彈跳水療法</color>時，希格雯將為自己施加持續18秒的「半強制靜養」效果：持續期間，希格雯獲得8%<color=#80C0FFFF>水元素傷害加成</color>與10層靜養計數，除希格雯外附近隊伍中處於後臺的角色的元素戰技造成傷害時，將消耗1層靜養計數，提升此次元素戰技造成的傷害值：希格雯的生命值上限超過30000的部分，每1000點生命值上限將提升80點傷害，依此方式，至多使本次元素戰技造成的傷害提升2800點。","descriptionBuff":"","icon":"UI_Talent_S_Sigewinne_05","linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":0,"type":"normal"}]}},"5":{"skillId":9522,"type":2,"name":"細緻入微的診療","description":"希格雯進行治療時，將基於隊伍中所有角色目前生命之契的總和，提升本次治療量：每1000點生命之契都將提升3%治療量，至多依此方式提升30%治療量。","descriptionBuff":"","icon":"UI_Talent_S_Sigewinne_06","linkedConstellations":null},"6":{"skillId":9523,"type":2,"name":"急性劑量","description":"在水下時，目前場上自己的角色的生命值降低至50%以下時，將在2.5秒內為其持續恢復生命值，總回復量相當於其生命值上限的50%，並在10秒內使該角色的所有元素抗性和物理抗性下降10%。該效果每20秒最多觸發一次。","descriptionBuff":"","icon":"UI_Talent_S_Sigewinne_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":951,"name":"「最快樂的精靈，可否懂得焦慮」","description":"<color=#FFD780FF>彈跳水療法</color>的激癒水球能額外彈跳3次。前3次彈跳不會使較大激癒水球變小。\\n此外，突破天賦「應有適當的休憩」的效果獲得提升：激癒水球彈跳時，將為希格雯賦予1層靜養計數，並使靜養計數產生的傷害值提升改為：希格雯的生命值上限超過30000的部分，每1000點生命值上限將提升100點，依此方式，至多提升3500點傷害。此效果需要解鎖突破天賦「應有適當的休憩」。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sigewinne_01"},"1":{"id":1,"talentId":952,"name":"「最仁慈的精靈，可否化解仇敵」","description":"施放<color=#FFD780FF>彈跳水療法</color>與<color=#FFD780FF>過飽和心意注射</color>時，將生成一個傷害吸收量等同於生命值上限30%的水球護盾，對<color=#80C0FFFF>水元素傷害</color>有250%的吸收效果，持續直到施放完成。\\n此外，彈跳水療法丟擲的激癒水球或過飽和心意注射命中敵人後，該敵人的<color=#80C0FFFF>水元素抗性</color>降低35%，持續8秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sigewinne_02"},"2":{"id":2,"talentId":953,"name":"「最健康的精靈，可否療癒熱症」","description":"<color=#FFD780FF>彈跳水療法</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Sigewinne_01"},"3":{"id":3,"talentId":954,"name":"「最美麗的精靈，可否拒絕衰朽」","description":"<color=#FFD780FF>過飽和心意注射</color>的持續時間延長3秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sigewinne_03"},"4":{"id":4,"talentId":955,"name":"「最幸福的精靈，可否消卻折磨」","description":"<color=#FFD780FF>過飽和心意注射</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Sigewinne_02"},"5":{"id":5,"talentId":956,"name":"「最光輝的精靈，可否為我禱告」","description":"希格雯進行治療時，將基於生命值上限，提升自己的<color=#FFD780FF>過飽和心意注射</color>的暴擊率和暴擊傷害：每1000點生命值上限都將提升0.4%暴擊率與2.2%暴擊傷害，持續15秒。至多依此方式提升20%暴擊率與110%暴擊傷害。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Sigewinne_04"}},"dictionary":null}}