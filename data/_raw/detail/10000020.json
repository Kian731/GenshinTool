印時發生溢出，雷狼將會引下落雷攻擊附近的敵人，造成相當於雷澤150%攻擊力的雷元素範圍傷害，並為雷澤恢復7點元素能量。每1秒至多觸發一次該效果。","descriptionBuff":"","icon":"UI_Talent_S_Razor_07","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":201,"name":"狼性","description":"雷澤獲得元素晶球或元素微粒後的8秒內，造成的傷害提高10%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Razor_01"},"1":{"id":1,"talentId":202,"name":"壓制","description":"雷澤攻擊生命值低於30%的敵人時，暴擊率提高10%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Razor_02"},"2":{"id":2,"talentId":203,"name":"獸魂","description":"<color=#FFD780FF>雷牙</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Razor_02"},"3":{"id":3,"talentId":204,"name":"撕咬","description":"<color=#FFD780FF>利爪與蒼雷</color>點按時，會使命中的敵人防禦力降低15%，持續7秒。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Razor_03"},"4":{"id":4,"talentId":205,"name":"利爪","description":"<color=#FFD780FF>利爪與蒼雷</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Razor_01"},"5":{"id":5,"talentId":206,"name":"天狼","description":"每10秒，雷澤的大劍將自動充能，使下一次普通攻擊引發落雷，造成100%攻擊力的<color=#FFACFFFF>雷元素傷害</color>。\\n不處於<color=#FFD780FF>雷牙</color>狀態下時，若落雷擊中敵人，會為雷澤累積一個<color=#FFD780FF>利爪與蒼雷</color>的雷之印。","descriptionBuff":"每10秒，雷澤的大劍將自動充能，使下一次普通攻擊引發落雷，造成100%攻擊力的<color=#FFACFFFF>雷元素傷害</color>。\\n不處於<color=#FFD780FF>雷牙</color>狀態下時，若落雷擊中敵人，會為雷澤累積三個元素戰技<color=#FFD780FF>利爪與蒼雷</color>中的雷之印。\\n此外，雷澤透過元素戰技<color=#FFD780FF>利爪與蒼雷</color>累積雷之印時，會改為為雷澤累積三個雷之印。\\n消耗雷之印後的15秒內，雷澤的暴擊率提升10%，暴擊傷害提升50%。","extraData":null,"icon":"UI_Talent_S_Razor_04","advancedProps":[{"name":"Lightning","elementalGaugeTheory":"1U","internalCooldown":null,"interruptionResistance":"69","interruptionResistanceStagger":{"staggerLevel":"Light","horizontalForce":"200","verticalForce":"0"},"bluntAttack":false}]}},"dictionary":null,"buff":true}