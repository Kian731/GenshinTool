":{"isLevelIncluded":true,"prop":[{"id":0,"type":"normal"},{"id":2,"type":"level"},{"id":3,"type":"normal"}]}},"4":{"skillId":8021,"type":2,"name":"速射牽制","description":"在下列情況下，<color=#FFD780FF>星霜的流旋</color>的靈風狀態將獲得偵明效果強化，使角色處於場上時，造成的物理傷害提升10%：\\n·霜流矢命中超過1名敵人時，每額外命中1名敵人就產生1層偵明效果；\\n·冰星破片命中敵人時，將產生1層偵明效果。每枚冰星破片只能觸發1次。\\n\\n靈風狀態的偵明效果至多疊加3層，在持續期間內重複施放星霜的流旋時，將移除原有的靈風狀態與其偵明效果。","descriptionBuff":"","icon":"UI_Talent_S_Mika_05","linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":1,"type":"normal"},{"id":5,"type":"normal"}]}},"5":{"skillId":8022,"type":2,"name":"地貌測繪","description":"同時處於<color=#FFD780FF>蒼翎的頌願</color>的鷹翎狀態與<color=#FFD780FF>星霜的流旋</color>的靈風狀態下的目前場上角色，在攻擊造成暴擊時，靈風狀態將產生1層突破天賦「速射牽制」的偵明效果。在一次靈風狀態的持續期間內，依此方式至多產生1層偵明效果。\\n此外，靈風狀態下偵明效果疊加層數上限提升1層。\\n需要解鎖突破天賦「速射牽制」。","descriptionBuff":"","icon":"UI_Talent_S_Mika_06","linkedConstellations":null},"6":{"skillId":8023,"type":2,"name":"勘界定標","description":"在小地圖上顯示周圍的<color=#FFD780FF>蒙德區域特產</color>的位置。","descriptionBuff":"","icon":"UI_Talent_Collect_Local_Mengde","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":801,"name":"遇合的因緣","description":"<color=#FFD780FF>星霜的流旋</color>產生的靈風狀態能使<color=#FFD780FF>蒼翎的頌願</color>的鷹翎狀態恢復生命值的間隔降低，降低比例等同於靈風狀態提供的攻擊速度提升比例。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Mika_01"},"1":{"id":1,"talentId":802,"name":"伴行的旅路","description":"<color=#FFD780FF>星霜的流旋</color>的霜流矢首次命中敵人時，或是冰星信標命中敵人時，將產生1層突破天賦「速射牽制」的偵明效果。\\n需要解鎖突破天賦「速射牽制」。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Mika_02"},"2":{"id":2,"talentId":803,"name":"游擊的心得","description":"<color=#FFD780FF>蒼翎的頌願</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":9,"extraLevel":3}},"icon":"UI_Talent_U_Mika_01"},"3":{"id":3,"talentId":804,"name":"晴霜的祝念","description":"米卡自己的<color=#FFD780FF>蒼翎的頌願</color>的鷹翎狀態為隊伍中的角色進行治療時，將為米卡恢復3點元素能量。透過一次施放蒼翎的頌願產生的鷹翎狀態，至多恢復5次元素能量。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Mika_03"},"4":{"id":4,"talentId":805,"name":"引示的鈴箭","description":"<color=#FFD780FF>星霜的流旋</color>的技能等級提高3級。\\n至多提升至15級。","descriptionBuff":null,"extraData":{"addTalentExtraLevel":{"talentType":"AvatarSkill","talentIndex":2,"extraLevel":3}},"icon":"UI_Talent_U_Mika_02"},"5":{"id":5,"talentId":806,"name":"依隨的策援","description":"<color=#FFD780FF>星霜的流旋</color>靈風狀態下的偵明效果疊加層數上限提升1層。需要解鎖突破天賦「速射牽制」。\\n此外，處於靈風狀態下的目前場上角色，其物理傷害的暴擊傷害提高60%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Mika_04"}},"dictionary":null}}